local STORAGE_PROTOCOL = "cooks_storage_v2"
local STRESS_PROTOCOL  = "cooks_stress_v1"

local NODE_TIMEOUT = 20

--------------------------------------------------
-- FIND WIRELESS MODEM
--------------------------------------------------

local wirelessModem = nil

for _, name in ipairs(peripheral.getNames()) do
    if peripheral.hasType(name, "modem") then
        local modem = peripheral.wrap(name)

        if modem
            and modem.isWireless
            and modem.isWireless()
        then
            wirelessModem = name
            break
        end
    end
end

if not wirelessModem then
    error("No wireless modem found!")
end

if not rednet.isOpen(wirelessModem) then
    rednet.open(wirelessModem)
end

