-- ============================================================
-- COOK'S STORAGE - DISPLAY
-- Computer #1
-- Wireless modem: FRONT
-- Monitor: RIGHT
-- ============================================================

local MODEM_SIDE = "front"
local MONITOR_SIDE = "right"
local SERVER_ID = 0
local PROTOCOL = "realcraft_storage"

local monitor = peripheral.wrap(MONITOR_SIDE)

if not monitor then
    error("Monitor not found on " .. MONITOR_SIDE)
end

if not rednet.isOpen(MODEM_SIDE) then
    rednet.open(MODEM_SIDE)
end

monitor.setTextScale(0.5)

local history = {}
local lastHistorySample = 0
local lastDataTime = 0

-- ------------------------------------------------------------
-- Helpers
-- ------------------------------------------------------------

local function comma(number)
    number = math.floor(tonumber(number) or 0)

    local sign = ""

    if number < 0 then
        sign = "-"
        number = math.abs(number)
    end

    local text = tostring(number)

    while true do
        local changed, count =
            text:gsub("^(%d+)(%d%d%d)", "%1,%2")

        text = changed

        if count == 0 then
            break
        end
    end

    return sign .. text
end

local function short(number)
    number = tonumber(number) or 0
    local absolute = math.abs(number)

    if absolute >= 1000000000 then
        return string.format("%.1fB", number / 1000000000)
    elseif absolute >= 1000000 then
        return string.format("%.1fM", number / 1000000)
    elseif absolute >= 1000 then
        return string.format("%.1fK", number / 1000)
    end

    return tostring(math.floor(number))
end

local function cleanItemName(name)
    name = tostring(name or "?")

    name = name:match(":(.+)$") or name
    name = name:gsub("_", " ")

    return name
end

local function writeAt(x, y, text, color, background)
    local width, height = monitor.getSize()

    if y < 1 or y > height then
        return
    end

    if x < 1 or x > width then
        return
    end

    text = tostring(text)

    if #text > width - x + 1 then
        text = text:sub(1, width - x + 1)
    end

    monitor.setCursorPos(x, y)
    monitor.setTextColor(color or colors.white)
    monitor.setBackgroundColor(background or colors.black)
    monitor.write(text)
end

local function fill(x, y, width, color)
    local screenWidth = monitor.getSize()

    width = math.min(width, screenWidth - x + 1)

    if width <= 0 then
        return
    end

    monitor.setCursorPos(x, y)
    monitor.setBackgroundColor(color)
    monitor.write(string.rep(" ", width))
    monitor.setBackgroundColor(colors.black)
end

local function line(y, color)
    local width = monitor.getSize()

    writeAt(
        2,
        y,
        string.rep("-", math.max(1, width - 3)),
        color or colors.gray
    )
end

local function bar(x, y, width, ratio, color)
    ratio = math.max(0, math.min(1, ratio or 0))

    fill(x, y, width, colors.gray)

    local amount = math.floor(width * ratio)

    if amount > 0 then
        fill(x, y, amount, color)
    end
end

local function percentColor(percent)
    if percent >= 0.90 then
        return colors.red
    elseif percent >= 0.75 then
        return colors.orange
    end

    return colors.lime
end

-- ------------------------------------------------------------
-- Category colors
-- ------------------------------------------------------------

local CATEGORY_ORDER = {
    {"Wood", colors.brown},
    {"Ores/Gems", colors.orange},
    {"Tools", colors.lightGray},
    {"Misc", colors.gray},
    {"Armor", colors.cyan},
    {"Potions", colors.purple},
    {"Blocks", colors.lightGray},
    {"Create", colors.magenta},
    {"Food", colors.lime},
    {"Weapons", colors.red}
}

local function drawCompositionBar(data, x, y, width)
    local total = data.totalItems or 0

    if total <= 0 then
        fill(x, y, width, colors.gray)
        return
    end

    local cursor = x
    local remaining = width

    for index, entry in ipairs(CATEGORY_ORDER) do
        local category = entry[1]
        local color = entry[2]

        local count =
            (data.categories and data.categories[category])
            or 0

        local ratio = count / total

        local amount

        if index == #CATEGORY_ORDER then
            amount = remaining
        else
            amount = math.floor(width * ratio)
            amount = math.min(amount, remaining)
        end

        if amount > 0 then
            fill(cursor, y, amount, color)

            cursor = cursor + amount
            remaining = remaining - amount
        end
    end

    if remaining > 0 then
        fill(cursor, y, remaining, colors.gray)
    end
end

-- ------------------------------------------------------------
-- History graph
-- ------------------------------------------------------------

local function addHistory(value)
    local now = os.epoch("utc")

    -- roughly one sample per minute
    if now - lastHistorySample >= 60000 then
        lastHistorySample = now

        table.insert(history, value)

        while #history > 60 do
            table.remove(history, 1)
        end
    end
end

local function drawGraph(x, y, width, height)
    if #history == 0 then
        return
    end

    local minimum = history[1]
    local maximum = history[1]

    for _, value in ipairs(history) do
        minimum = math.min(minimum, value)
        maximum = math.max(maximum, value)
    end

    local range = math.max(1, maximum - minimum)

    local startIndex =
        math.max(1, #history - width + 1)

    local values = {}

    for i = startIndex, #history do
        table.insert(values, history[i])
    end

    for column = 1, #values do
        local ratio =
            (values[column] - minimum) / range

        local graphHeight =
            math.floor(ratio * (height - 1)) + 1

        for row = 0, graphHeight - 1 do
            local py = y + height - 1 - row

            writeAt(
                x + column - 1,
                py,
                " ",
                colors.white,
                colors.green
            )
        end
    end

    -- line along top of each bar
    for column = 1, #values do
        local ratio =
            (values[column] - minimum) / range

        local graphHeight =
            math.floor(ratio * (height - 1)) + 1

        local py =
            y + height - graphHeight

        writeAt(
            x + column - 1,
            py,
            "-",
            colors.lime,
            colors.green
        )
    end
end

-- ------------------------------------------------------------
-- Offline screen
-- ------------------------------------------------------------

local function drawOffline()
    monitor.setBackgroundColor(colors.black)
    monitor.clear()

    writeAt(
        2,
        2,
        "COOK'S STORAGE",
        colors.orange
    )

    writeAt(
        2,
        4,
        "WAITING FOR STORAGE SERVER...",
        colors.yellow
    )

    writeAt(
        2,
        6,
        "Computer #0 -> Computer #1",
        colors.lightGray
    )
end

-- ------------------------------------------------------------
-- Main dashboard
-- ------------------------------------------------------------

local function draw(data)
    monitor.setBackgroundColor(colors.black)
    monitor.clear()

    local width, height = monitor.getSize()

    local usedSlots =
        tonumber(data.usedSlots) or 0

    local totalSlots =
        tonumber(data.totalSlots) or 0

    local totalItems =
        tonumber(data.totalItems) or 0

    local slotPercent = 0

    if totalSlots > 0 then
        slotPercent =
            usedSlots / totalSlots
    end

    addHistory(usedSlots)

    -- ========================================================
    -- HEADER
    -- ========================================================

    writeAt(
        2,
        1,
        "COOK'S STORAGE",
        colors.white
    )

    writeAt(
        18,
        1,
        tostring(data.inventories or 0)
            .. " inventories",
        colors.gray
    )

    writeAt(
        34,
        1,
        tostring(data.itemTypes or 0)
            .. " item types",
        colors.gray
    )

    local clock =
        textutils.formatTime(os.time(), true)

    writeAt(
        width - #clock,
        1,
        clock,
        colors.gray
    )

    -- ========================================================
    -- STORAGE %
    -- ========================================================

    local mainColor =
        percentColor(slotPercent)

    writeAt(
        2,
        3,
        tostring(math.floor(slotPercent * 100))
            .. "%",
        mainColor
    )

    writeAt(
        2,
        4,
        "FULL",
        colors.gray
    )

    writeAt(
        12,
        3,
        comma(usedSlots)
            .. " / "
            .. comma(totalSlots)
            .. " slots used",
        colors.white
    )

    bar(
        12,
        4,
        width - 14,
        slotPercent,
        mainColor
    )

    writeAt(
        12,
        5,
        short(totalItems) .. " items",
        colors.lightGray
    )

    local slotRate =
        tonumber(data.slotsPerMinute) or 0

    local itemRate =
        tonumber(data.itemsPerMinute) or 0

    local rateX = 27

    local slotText =
        (slotRate >= 0 and "+" or "")
        .. short(slotRate)
        .. " slots/min"

    writeAt(
        rateX,
        5,
        slotText,
        slotRate >= 0
            and colors.lime
            or colors.red
    )

    local itemText =
        (itemRate >= 0 and "+" or "")
        .. short(itemRate)
        .. " items/min"

    writeAt(
        rateX + 18,
        5,
        itemText,
        itemRate >= 0
            and colors.lime
            or colors.red
    )

    -- ========================================================
    -- COMPOSITION
    -- ========================================================

    writeAt(
        2,
        7,
        "COMPOSITION",
        colors.gray
    )

    drawCompositionBar(
        data,
        2,
        8,
        width - 3
    )

    local legendY = 9
    local legendX = 2

    for i, entry in ipairs(CATEGORY_ORDER) do
        local name = entry[1]
        local color = entry[2]

        local count =
            (data.categories and data.categories[name])
            or 0

        local percentage = 0

        if totalItems > 0 then
            percentage =
                math.floor((count / totalItems) * 100)
        end

        writeAt(
            legendX,
            legendY,
            name .. " " .. percentage .. "%",
            color
        )

        legendX = legendX + 15

        if legendX + 14 > width then
            legendX = 2
            legendY = legendY + 1
        end
    end

    -- ========================================================
    -- HISTORY
    -- ========================================================

    local graphTitleY = legendY + 2

    writeAt(
        2,
        graphTitleY,
        "SLOTS USED - LAST 60 MIN",
        colors.gray
    )

    local graphY = graphTitleY + 1
    local graphHeight = 4

    drawGraph(
        2,
        graphY,
        width - 3,
        graphHeight
    )

    -- ========================================================
    -- LOWER SECTION
    -- ========================================================

    local lowerY =
        graphY + graphHeight + 1

    local rightX =
        math.max(
            36,
            math.floor(width * 0.56)
        )

    -- TOP CONSUMERS
    writeAt(
        2,
        lowerY,
        "TOP CONSUMERS",
        colors.gray
    )

    local topItems =
        data.topItems or {}

    local rowsAvailable =
        math.max(1, height - lowerY - 3)

    local maxTop =
        math.min(7, #topItems, rowsAvailable)

    for i = 1, maxTop do
        local item = topItems[i]

        local itemName =
            cleanItemName(item.name)

        if #itemName > 18 then
            itemName =
                itemName:sub(1, 18)
        end

        local y =
            lowerY + i

        writeAt(
            2,
            y,
            string.format(
                "%-18s",
                itemName
            ),
            colors.white
        )

        writeAt(
            21,
            y,
            string.format(
                "%7s",
                short(item.count)
            ),
            colors.lightGray
        )

        local ratio = 0

        if topItems[1]
            and topItems[1].count > 0
        then
            ratio =
                item.count / topItems[1].count
        end

        bar(
            29,
            y,
            math.max(4, rightX - 31),
            ratio,
            colors.orange
        )
    end

    -- STORAGE UNITS
    writeAt(
        rightX,
        lowerY,
        "STORAGE",
        colors.gray
    )

    local units =
        data.storageUnits or {}

    local maxUnits =
        math.min(
            7,
            #units,
            rowsAvailable
        )

    for i = 1, maxUnits do
        local unit = units[i]

        local y =
            lowerY + i

        local ratio = 0

        if unit.totalSlots
            and unit.totalSlots > 0
        then
            ratio =
                unit.usedSlots
                / unit.totalSlots
        end

        local label =
            tostring(unit.name or "Storage")

        if #label > 15 then
            label = label:sub(1, 15)
        end

        writeAt(
            rightX,
            y,
            string.format(
                "%-15s",
                label
            ),
            colors.white
        )

        local barX =
            rightX + 16

        local barWidth =
            math.max(
                5,
                width - barX - 5
            )

        bar(
            barX,
            y,
            barWidth,
            ratio,
            percentColor(ratio)
        )

        writeAt(
            width - 3,
            y,
            tostring(
                math.floor(ratio * 100)
            ) .. "%",
            ratio >= 0.90
                and colors.red
                or colors.lightGray
        )
    end

    -- ========================================================
    -- STATUS / ALERTS
    -- ========================================================

    if height >= 2 then
        if slotPercent >= 0.95 then
            writeAt(
                2,
                height,
                "ALERT: STORAGE IS 95%+ FULL",
                colors.red
            )

        elseif slotPercent >= 0.85 then
            writeAt(
                2,
                height,
                "WARNING: STORAGE APPROACHING CAPACITY",
                colors.orange
            )

        else
            writeAt(
                2,
                height,
                "COOK'S STORAGE ONLINE",
                colors.green
            )
        end

        writeAt(
            width - 10,
            height,
            tostring(data.inventories or 0)
                .. " active",
            colors.gray
        )
    end
end

-- ------------------------------------------------------------
-- Run
-- ------------------------------------------------------------

drawOffline()

while true do
    local sender, message, protocol =
        rednet.receive(PROTOCOL, 15)

    if sender == SERVER_ID
        and type(message) == "table"
    then
        lastDataTime = os.epoch("utc")
        draw(message)
    else
        drawOffline()
    end
end
