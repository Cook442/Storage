-- ============================================================
-- COOK'S STORAGE - MASTER DISPLAY
-- Computer #1
-- Automatically discovers unlimited storage nodes
-- ============================================================

local PROTOCOL = "cooks_storage_v2"
local NODE_TIMEOUT = 20

--------------------------------------------------
-- FIND WIRELESS MODEM
--------------------------------------------------

local wirelessModem = nil

for _, name in ipairs(peripheral.getNames()) do
    if peripheral.hasType(name, "modem") then
        local modem = peripheral.wrap(name)

        if modem and modem.isWireless and modem.isWireless() then
            wirelessModem = name
            break
        end
    end
end

if not wirelessModem then
    error("No wireless modem found!")
end

if not rednet.isOpen(wirelessModem) then
    rednet.open(wirelessModem)
end

--------------------------------------------------
-- FIND MONITOR
--------------------------------------------------

local monitor = peripheral.find("monitor")

if not monitor then
    error("No monitor found!")
end

monitor.setTextScale(0.5)

--------------------------------------------------
-- DATA
--------------------------------------------------

local nodes = {}
local history = {}
local lastHistorySample = 0

local CATEGORY_ORDER = {
    {"Wood", colors.brown},
    {"Ores/Gems", colors.orange},
    {"Tools", colors.lightGray},
    {"Misc", colors.gray},
    {"Armor", colors.cyan},
    {"Potions", colors.purple},
    {"Blocks", colors.white},
    {"Create", colors.magenta},
    {"Food", colors.lime},
    {"Weapons", colors.red}
}

--------------------------------------------------
-- HELPERS
--------------------------------------------------

local function short(n)

    n = tonumber(n) or 0

    if math.abs(n) >= 1000000000 then
        return string.format("%.1fB", n / 1000000000)

    elseif math.abs(n) >= 1000000 then
        return string.format("%.1fM", n / 1000000)

    elseif math.abs(n) >= 1000 then
        return string.format("%.1fK", n / 1000)
    end

    return tostring(math.floor(n))
end

local function comma(n)

    n = math.floor(tonumber(n) or 0)

    local text = tostring(n)

    while true do

        local new, changes =
            text:gsub(
                "^(-?%d+)(%d%d%d)",
                "%1,%2"
            )

        text = new

        if changes == 0 then
            break
        end
    end

    return text
end

local function cleanName(name)

    name = tostring(name or "?")

    name =
        name:match(":(.+)$")
        or name

    name =
        name:gsub("_", " ")

    return name
end

local function writeAt(x, y, text, fg, bg)

    local w, h =
        monitor.getSize()

    if x < 1
        or y < 1
        or x > w
        or y > h
    then
        return
    end

    text = tostring(text)

    if #text > w - x + 1 then
        text =
            text:sub(
                1,
                w - x + 1
            )
    end

    monitor.setCursorPos(x, y)

    monitor.setTextColor(
        fg or colors.white
    )

    monitor.setBackgroundColor(
        bg or colors.black
    )

    monitor.write(text)
end

local function fill(x, y, width, color)

    local screenWidth =
        monitor.getSize()

    width =
        math.min(
            width,
            screenWidth - x + 1
        )

    if width <= 0 then
        return
    end

    monitor.setCursorPos(x, y)

    monitor.setBackgroundColor(color)

    monitor.write(
        string.rep(" ", width)
    )

    monitor.setBackgroundColor(
        colors.black
    )
end

local function bar(x, y, width, ratio, color)

    ratio =
        math.max(
            0,
            math.min(1, ratio or 0)
        )

    fill(
        x,
        y,
        width,
        colors.gray
    )

    local amount =
        math.floor(
            width * ratio
        )

    if amount > 0 then
        fill(
            x,
            y,
            amount,
            color
        )
    end
end

local function usageColor(ratio)

    if ratio >= 0.90 then
        return colors.red

    elseif ratio >= 0.75 then
        return colors.orange
    end

    return colors.lime
end

--------------------------------------------------
-- COMBINE ALL ONLINE NODES
--------------------------------------------------

local function combine()

    local result = {

        activeNodes = 0,

        inventories = 0,

        totalSlots = 0,
        usedSlots = 0,

        totalItems = 0,
        itemTypes = 0,

        itemsPerMinute = 0,
        slotsPerMinute = 0,

        categories = {},
        topItems = {},
        nodes = {}
    }

    for _, category in ipairs(CATEGORY_ORDER) do
        result.categories[category[1]] = 0
    end

    local combinedItems = {}

    local now =
        os.epoch("utc")

    --------------------------------------------------
    -- NODES
    --------------------------------------------------

    for id, node in pairs(nodes) do

        if
            now - node.lastSeen
            <= NODE_TIMEOUT * 1000
        then

            local data =
                node.data

            result.activeNodes =
                result.activeNodes + 1

            result.inventories =
                result.inventories
                + (data.inventories or 0)

            result.totalSlots =
                result.totalSlots
                + (data.totalSlots or 0)

            result.usedSlots =
                result.usedSlots
                + (data.usedSlots or 0)

            result.totalItems =
                result.totalItems
                + (data.totalItems or 0)

            result.itemTypes =
                result.itemTypes
                + (data.itemTypes or 0)

            result.itemsPerMinute =
                result.itemsPerMinute
                + (data.itemsPerMinute or 0)

            result.slotsPerMinute =
                result.slotsPerMinute
                + (data.slotsPerMinute or 0)

            for category, count
                in pairs(data.categories or {})
            do

                result.categories[category] =
                    (result.categories[category] or 0)
                    + count
            end

            for _, item
                in ipairs(data.topItems or {})
            do

                combinedItems[item.name] =
                    (combinedItems[item.name] or 0)
                    + item.count
            end

            table.insert(
                result.nodes,
                {
                    id = id,
                    name =
                        data.nodeName
                        or ("Storage #" .. id),

                    inventories =
                        data.inventories or 0,

                    items =
                        data.totalItems or 0,

                    usedSlots =
                        data.usedSlots or 0,

                    totalSlots =
                        data.totalSlots or 0
                }
            )
        end
    end

    --------------------------------------------------
    -- TOP ITEMS
    --------------------------------------------------

    for name, count
        in pairs(combinedItems)
    do
        table.insert(
            result.topItems,
            {
                name = name,
                count = count
            }
        )
    end

    table.sort(
        result.topItems,
        function(a, b)
            return a.count > b.count
        end
    )

    while #result.topItems > 8 do
        table.remove(result.topItems)
    end

    --------------------------------------------------
    -- SORT NODES BY NAME
    --------------------------------------------------

    table.sort(
        result.nodes,
        function(a, b)
            return
                string.lower(a.name)
                < string.lower(b.name)
        end
    )

    return result
end

--------------------------------------------------
-- COMPOSITION BAR
--------------------------------------------------

local function drawComposition(data, x, y, width)

    if data.totalItems <= 0 then
        fill(
            x,
            y,
            width,
            colors.gray
        )

        return
    end

    local currentX = x
    local remaining = width

    for index, entry
        in ipairs(CATEGORY_ORDER)
    do

        local name = entry[1]
        local color = entry[2]

        local count =
            data.categories[name] or 0

        local amount

        if index == #CATEGORY_ORDER then

            amount = remaining

        else

            amount =
                math.floor(
                    width
                    * count
                    / data.totalItems
                )

            amount =
                math.min(
                    amount,
                    remaining
                )
        end

        if amount > 0 then

            fill(
                currentX,
                y,
                amount,
                color
            )

            currentX =
                currentX + amount

            remaining =
                remaining - amount
        end
    end
end

--------------------------------------------------
-- HISTORY
--------------------------------------------------

local function sampleHistory(value)

    local now =
        os.epoch("utc")

    if
        now - lastHistorySample
        >= 60000
    then

        lastHistorySample = now

        table.insert(
            history,
            value
        )

        while #history > 60 do
            table.remove(history, 1)
        end
    end
end

local function drawGraph(x, y, width, height)

    if #history == 0 then
        return
    end

    local minimum =
        history[1]

    local maximum =
        history[1]

    for _, value
        in ipairs(history)
    do

        minimum =
            math.min(
                minimum,
                value
            )

        maximum =
            math.max(
                maximum,
                value
            )
    end

    local range =
        math.max(
            1,
            maximum - minimum
        )

    local start =
        math.max(
            1,
            #history - width + 1
        )

    local column = 0

    for i = start, #history do

        column =
            column + 1

        local ratio =
            (history[i] - minimum)
            / range

        local graphHeight =
            math.floor(
                ratio * (height - 1)
            ) + 1

        for row = 0, graphHeight - 1 do

            writeAt(
                x + column - 1,
                y + height - 1 - row,
                " ",
                colors.white,
                colors.green
            )
        end
    end
end

--------------------------------------------------
-- DRAW
--------------------------------------------------

local function draw()

    local data =
        combine()

    sampleHistory(
        data.usedSlots
    )

    monitor.setBackgroundColor(
        colors.black
    )

    monitor.clear()

    local w, h =
        monitor.getSize()

    --------------------------------------------------
    -- HEADER
    --------------------------------------------------

    writeAt(
        2,
        1,
        "COOK'S STORAGE",
        colors.white
    )

    writeAt(
        19,
        1,
        data.activeNodes
            .. " nodes",
        colors.gray
    )

    writeAt(
        30,
        1,
        data.inventories
            .. " inventories",
        colors.gray
    )

    local clock =
        textutils.formatTime(
            os.time(),
            true
        )

    writeAt(
        w - #clock,
        1,
        clock,
        colors.gray
    )

    --------------------------------------------------
    -- CAPACITY
    --------------------------------------------------

    local ratio = 0

    if data.totalSlots > 0 then
        ratio =
            data.usedSlots
            / data.totalSlots
    end

    local mainColor =
        usageColor(ratio)

    writeAt(
        2,
        3,
        math.floor(ratio * 100)
            .. "%",
        mainColor
    )

    writeAt(
        2,
        4,
        "FULL",
        colors.gray
    )

    writeAt(
        11,
        3,
        comma(data.usedSlots)
            .. " / "
            .. comma(data.totalSlots)
            .. " slots used",
        colors.white
    )

    bar(
        11,
        4,
        w - 13,
        ratio,
        mainColor
    )

    writeAt(
        11,
        5,
        short(data.totalItems)
            .. " items",
        colors.lightGray
    )

    local itemRate =
        data.itemsPerMinute

    writeAt(
        28,
        5,
        (itemRate >= 0 and "+" or "")
            .. short(itemRate)
            .. " items/min",
        itemRate >= 0
            and colors.lime
            or colors.red
    )

    --------------------------------------------------
    -- COMPOSITION
    --------------------------------------------------

    writeAt(
        2,
        7,
        "COMPOSITION",
        colors.gray
    )

    drawComposition(
        data,
        2,
        8,
        w - 3
    )

    local lx = 2
    local ly = 9

    for _, entry
        in ipairs(CATEGORY_ORDER)
    do

        local name =
            entry[1]

        local count =
            data.categories[name]
            or 0

        local percent = 0

        if data.totalItems > 0 then
            percent =
                math.floor(
                    count
                    / data.totalItems
                    * 100
                )
        end

        writeAt(
            lx,
            ly,
            name
                .. " "
                .. percent
                .. "%",
            entry[2]
        )

        lx = lx + 15

        if lx + 14 > w then
            lx = 2
            ly = ly + 1
        end
    end

    --------------------------------------------------
    -- GRAPH
    --------------------------------------------------

    local graphTitleY =
        ly + 2

    writeAt(
        2,
        graphTitleY,
        "SLOTS USED - LAST 60 MIN",
        colors.gray
    )

    drawGraph(
        2,
        graphTitleY + 1,
        w - 3,
        4
    )

    --------------------------------------------------
    -- LOWER HALF
    --------------------------------------------------

    local bottomY =
        graphTitleY + 6

    local rightX =
        math.floor(w * 0.56)

    writeAt(
        2,
        bottomY,
        "TOP CONSUMERS",
        colors.gray
    )

    for i, item
        in ipairs(data.topItems)
    do

        local y =
            bottomY + i

        if y >= h then
            break
        end

        local name =
            cleanName(item.name)

        if #name > 18 then
            name =
                name:sub(1, 18)
        end

        writeAt(
            2,
            y,
            string.format(
                "%-18s",
                name
            ),
            colors.white
        )

        writeAt(
            21,
            y,
            string.format(
                "%7s",
                short(item.count)
            ),
            colors.lightGray
        )

        local topCount =
            data.topItems[1]
            and data.topItems[1].count
            or 1

        bar(
            29,
            y,
            math.max(
                4,
                rightX - 31
            ),
            item.count
                / math.max(1, topCount),
            colors.orange
        )
    end

    --------------------------------------------------
    -- STORAGE NODES
    --------------------------------------------------

    writeAt(
        rightX,
        bottomY,
        "STORAGE NETWORKS",
        colors.gray
    )

    for i, node
        in ipairs(data.nodes)
    do

        local y =
            bottomY + i

        if y >= h then
            break
        end

        local name =
            tostring(node.name)

        if #name > 16 then
            name =
                name:sub(1, 16)
        end

        local nodeRatio = 0

        if node.totalSlots > 0 then
            nodeRatio =
                node.usedSlots
                / node.totalSlots
        end

        writeAt(
            rightX,
            y,
            string.format(
                "%-16s",
                name
            ),
            colors.white
        )

        local bx =
            rightX + 17

        bar(
            bx,
            y,
            math.max(
                5,
                w - bx - 5
            ),
            nodeRatio,
            usageColor(nodeRatio)
        )

        writeAt(
            w - 3,
            y,
            math.floor(
                nodeRatio * 100
            ) .. "%",
            colors.lightGray
        )
    end

    --------------------------------------------------
    -- STATUS
    --------------------------------------------------

    if data.activeNodes == 0 then

        writeAt(
            2,
            h,
            "WAITING FOR STORAGE NODES...",
            colors.red
        )

    else

        writeAt(
            2,
            h,
            "COOK'S STORAGE ONLINE",
            colors.green
        )

        writeAt(
            w - 15,
            h,
            data.activeNodes
                .. " nodes online",
            colors.gray
        )
    end
end

--------------------------------------------------
-- MAIN
--------------------------------------------------

draw()

while true do

    local sender, message =
        rednet.receive(
            PROTOCOL,
            5
        )

    if sender
        and type(message) == "table"
        and message.nodeId
    then

        nodes[message.nodeId] = {
            data = message,
            lastSeen = os.epoch("utc")
        }
    end

    draw()
end
