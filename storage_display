--------------------------------------------------
-- NUMBER FORMAT
--------------------------------------------------

local function short(n)
    n = tonumber(n) or 0

    if math.abs(n) >= 1000000000 then
        return string.format("%.1fB", n / 1000000000)
    elseif math.abs(n) >= 1000000 then
        return string.format("%.1fM", n / 1000000)
    elseif math.abs(n) >= 1000 then
        return string.format("%.1fK", n / 1000)
    end

    return tostring(math.floor(n))
end

local function comma(n)
    n = math.floor(tonumber(n) or 0)

    local sign = ""

    if n < 0 then
        sign = "-"
        n = math.abs(n)
    end

    local text = tostring(n)

    while true do
        local changed, count =
            text:gsub("^(%d+)(%d%d%d)", "%1,%2")

        text = changed

        if count == 0 then
            break
        end
    end

    return sign .. text
end

local function cleanName(name)
    name = tostring(name or "?")
    name = name:match(":(.+)$") or name
    name = name:gsub("_", " ")

    return name
end

--------------------------------------------------
-- MONITOR DRAWING
--------------------------------------------------

local function writeAt(x, y, text, fg, bg)
    local w, h = monitor.getSize()

    if x < 1 or y < 1 or x > w or y > h then
        return
    end

    text = tostring(text)

    if #text > w - x + 1 then
        text = text:sub(1, w - x + 1)
    end

    monitor.setCursorPos(x, y)
    monitor.setTextColor(fg or colors.white)
    monitor.setBackgroundColor(bg or colors.black)
    monitor.write(text)
end

local function fill(x, y, width, color)
    local w = monitor.getSize()

    width = math.min(width, w - x + 1)

    if width <= 0 then
        return
    end

    monitor.setCursorPos(x, y)
    monitor.setBackgroundColor(color)
    monitor.write(string.rep(" ", width))
    monitor.setBackgroundColor(colors.black)
end

local function horizontalLine(y, color)
    local w = monitor.getSize()

    writeAt(
        2,
        y,
        string.rep("-", math.max(1, w - 3)),
        color or colors.gray
    )
end

local function bar(x, y, width, ratio, color)
    ratio = math.max(0, math.min(1, ratio or 0))

    fill(x, y, width, colors.gray)

    local amount = math.floor(width * ratio)

    if amount > 0 then
        fill(x, y, amount, color)
    end
end

local function usageColor(ratio)
    if ratio >= 0.95 then
        return colors.red
    elseif ratio >= 0.80 then
        return colors.orange
    end

    return colors.lime
end

--------------------------------------------------
-- REMOVE OFFLINE NODES
--------------------------------------------------

local function removeExpired()
    local now = os.epoch("utc")
    local timeout = NODE_TIMEOUT * 1000

    for id, node in pairs(storageNodes) do
        if now - node.lastSeen > timeout then
            storageNodes[id] = nil
        end
    end

    for id, node in pairs(stressNodes) do
        if now - node.lastSeen > timeout then
            stressNodes[id] = nil
        end
    end
end

--------------------------------------------------
-- COMBINE STORAGE
--------------------------------------------------

local function combineStorage()
    local result = {
        activeNodes = 0,
        inventories = 0,

        totalSlots = 0,
        usedSlots = 0,

        totalItems = 0,
        itemTypes = 0,

        itemsPerMinute = 0,
        slotsPerMinute = 0,

        categories = {},
        topItems = {},
        nodes = {}
    }

    for _, entry in ipairs(CATEGORY_ORDER) do
        result.categories[entry[1]] = 0
    end

    local combinedItems = {}

    for id, node in pairs(storageNodes) do
        local data = node.data

        result.activeNodes =
            result.activeNodes + 1

        result.inventories =
            result.inventories
            + (data.inventories or 0)

        result.totalSlots =
            result.totalSlots
            + (data.totalSlots or 0)

        result.usedSlots =
            result.usedSlots
            + (data.usedSlots or 0)

        result.totalItems =
            result.totalItems
            + (data.totalItems or 0)

        result.itemTypes =
            result.itemTypes
            + (data.itemTypes or 0)

        result.itemsPerMinute =
            result.itemsPerMinute
            + (data.itemsPerMinute or 0)

        result.slotsPerMinute =
            result.slotsPerMinute
            + (data.slotsPerMinute or 0)

        for category, count
            in pairs(data.categories or {})
        do
            result.categories[category] =
                (result.categories[category] or 0)
                + count
        end

        for _, item in ipairs(data.topItems or {}) do
            combinedItems[item.name] =
                (combinedItems[item.name] or 0)
                + item.count
        end

        table.insert(
            result.nodes,
            {
                id = id,

                name =
                    data.nodeName
                    or ("Storage #" .. id),

                inventories =
                    data.inventories or 0,

                totalItems =
                    data.totalItems or 0,

                usedSlots =
                    data.usedSlots or 0,

                totalSlots =
                    data.totalSlots or 0
            }
        )
    end

    for name, count in pairs(combinedItems) do
        table.insert(
            result.topItems,
            {
                name = name,
                count = count
            }
        )
    end

    table.sort(
        result.topItems,
        function(a, b)
            return a.count > b.count
        end
    )

    while #result.topItems > 8 do
        table.remove(result.topItems)
    end

    table.sort(
        result.nodes,
        function(a, b)
            return
                string.lower(a.name)
                < string.lower(b.name)
        end
    )

    return result
end

--------------------------------------------------
-- COMBINE STRESS
--------------------------------------------------

local function combineStress()
    local result = {
        activeNodes = 0,
        stress = 0,
        capacity = 0,
        available = 0,
        nodes = {}
    }

    for id, node in pairs(stressNodes) do
        local data = node.data

        local stress =
            tonumber(data.stress) or 0

        local capacity =
            tonumber(data.capacity) or 0

        result.activeNodes =
            result.activeNodes + 1

        result.stress =
            result.stress + stress

        result.capacity =
            result.capacity + capacity

        table.insert(
            result.nodes,
            {
                id = id,

                name =
                    data.nodeName
                    or ("Stress #" .. id),

                stress = stress,
                capacity = capacity
            }
        )
    end

    result.available =
        math.max(
            0,
            result.capacity - result.stress
        )

    table.sort(
        result.nodes,
        function(a, b)
            local ar = 0
            local br = 0

            if a.capacity > 0 then
                ar = a.stress / a.capacity
            end

            if b.capacity > 0 then
                br = b.stress / b.capacity
            end

            return ar > br
        end
    )

    return result
end

--------------------------------------------------
-- COMPOSITION
--------------------------------------------------

local function drawComposition(data, x, y, width)
    if data.totalItems <= 0 then
        fill(x, y, width, colors.gray)
        return
    end

    local currentX = x
    local remaining = width

    for i, entry in ipairs(CATEGORY_ORDER) do
        local category = entry[1]
        local color = entry[2]

        local count =
            data.categories[category] or 0

        local amount

        if i == #CATEGORY_ORDER then
            amount = remaining
        else
            amount =
                math.floor(
                    width
                    * count
                    / data.totalItems
                )

            amount =
                math.min(
                    amount,
                    remaining
                )
        end

        if amount > 0 then
            fill(
                currentX,
                y,
                amount,
                color
            )

            currentX =
                currentX + amount

            remaining =
                remaining - amount
        end
    end
end

--------------------------------------------------
-- HISTORY
--------------------------------------------------

local function sampleHistory(value)
    local now = os.epoch("utc")

    if now - lastHistorySample >= 60000 then
        lastHistorySample = now

        table.insert(history, value)

        while #history > 60 do
            table.remove(history, 1)
        end
    end
end

local function drawGraph(x, y, width, height)
    if #history == 0 then
        return
    end

    local minimum = history[1]
    local maximum = history[1]

    for _, value in ipairs(history) do
        minimum = math.min(minimum, value)
        maximum = math.max(maximum, value)
    end

    local range =
        math.max(
            1,
            maximum - minimum
        )

    local start =
        math.max(
            1,
            #history - width + 1
        )

    local values = {}

    for i = start, #history do
        table.insert(values, history[i])
    end

    for column, value in ipairs(values) do
        local ratio =
            (value - minimum)
            / range

        local graphHeight =
            math.floor(
                ratio * (height - 1)
            ) + 1

        for row = 0, graphHeight - 1 do
            local py =
                y + height - 1 - row

            writeAt(
                x + column - 1,
                py,
                " ",
                colors.white,
                colors.green
            )
        end

        local topY =
            y + height - graphHeight

        writeAt(
            x + column - 1,
            topY,
            "-",
            colors.lime,
            colors.green
        )
    end
end

--------------------------------------------------
-- FULL ETA
--------------------------------------------------

local function fullETA(data)
    if data.slotsPerMinute <= 0 then
        return nil
    end

    local remaining =
        data.totalSlots - data.usedSlots

    if remaining <= 0 then
        return "FULL"
    end

    local minutes =
        remaining / data.slotsPerMinute

    if minutes > 60 * 24 * 30 then
        return nil
    end

    if minutes >= 60 then
        local hours =
            math.floor(minutes / 60)

        local mins =
            math.floor(minutes % 60)

        return hours .. "h " .. mins .. "m"
    end

    return math.floor(minutes) .. "m"
end

--------------------------------------------------
-- DRAW
--------------------------------------------------

local function draw()
    removeExpired()

    local storage = combineStorage()
    local stress = combineStress()

    sampleHistory(storage.usedSlots)

    monitor.setBackgroundColor(colors.black)
    monitor.clear()

    local w, h = monitor.getSize()

    --------------------------------------------------
    -- HEADER
    --------------------------------------------------

    writeAt(
        2,
        1,
        "COOK'S STORAGE",
        colors.white
    )

    writeAt(
        18,
        1,
        storage.activeNodes
            .. " storage",
        colors.gray
    )

    writeAt(
        30,
        1,
        stress.activeNodes
            .. " stress",
        colors.gray
    )

    writeAt(
        41,
        1,
        storage.inventories
            .. " inventories",
        colors.gray
    )

    local clock =
        textutils.formatTime(
            os.time(),
            true
        )

    writeAt(
        w - #clock,
        1,
        clock,
        colors.gray
    )

    horizontalLine(2, colors.gray)

    --------------------------------------------------
    -- STORAGE SUMMARY
    --------------------------------------------------

    local storageRatio = 0

    if storage.totalSlots > 0 then
        storageRatio =
            storage.usedSlots
            / storage.totalSlots
    end

    local storageColor =
        usageColor(storageRatio)

    writeAt(
        2,
        4,
        math.floor(storageRatio * 100)
            .. "%",
        storageColor
    )

    writeAt(
        2,
        5,
        "FULL",
        colors.gray
    )

    writeAt(
        11,
        4,
        comma(storage.usedSlots)
            .. " / "
            .. comma(storage.totalSlots)
            .. " slots used",
        colors.white
    )

    bar(
        11,
        5,
        math.max(12, math.floor(w * 0.55)),
        storageRatio,
        storageColor
    )

    writeAt(
        11,
        6,
        short(storage.totalItems)
            .. " items",
        colors.lightGray
    )

    local itemRate =
        storage.itemsPerMinute or 0

    writeAt(
        26,
        6,
        (itemRate >= 0 and "+" or "")
            .. short(itemRate)
            .. " items/min",
        itemRate >= 0
            and colors.lime
            or colors.red
    )

    local slotRate =
        storage.slotsPerMinute or 0

    writeAt(
        44,
        6,
        (slotRate >= 0 and "+" or "")
            .. short(slotRate)
            .. " slots/min",
        slotRate >= 0
            and colors.lime
            or colors.red
    )

    local eta =
        fullETA(storage)

    if eta then
        writeAt(
            11,
            7,
            "full in " .. eta,
            colors.lightGray
        )
    end

    --------------------------------------------------
    -- STRESS SUMMARY
    --------------------------------------------------

    local stressX =
        math.max(
            60,
            math.floor(w * 0.72)
        )

    local stressRatio = 0

    if stress.capacity > 0 then
        stressRatio =
            stress.stress
            / stress.capacity
    end

    local stressColor =
        usageColor(stressRatio)

    writeAt(
        stressX,
        3,
        "STRESS",
        colors.gray
    )

    writeAt(
        stressX,
        4,
        math.floor(stressRatio * 100)
            .. "%",
        stressColor
    )

    bar(
        stressX + 7,
        4,
        math.max(
            6,
            w - stressX - 8
        ),
        stressRatio,
        stressColor
    )

    writeAt(
        stressX,
        5,
        short(stress.stress)
            .. " / "
            .. short(stress.capacity)
            .. " SU",
        colors.white
    )

    writeAt(
        stressX,
        6,
        short(stress.available)
            .. " SU available",
        colors.lightGray
    )

    --------------------------------------------------
    -- COMPOSITION
    --------------------------------------------------

    writeAt(
        2,
        9,
        "COMPOSITION",
        colors.gray
    )

    drawComposition(
        storage,
        2,
        10,
        w - 3
    )

    local legendX = 2
    local legendY = 11

    for _, entry in ipairs(CATEGORY_ORDER) do
        local name = entry[1]
        local color = entry[2]

        local count =
            storage.categories[name] or 0

        local percent = 0

        if storage.totalItems > 0 then
            percent =
                math.floor(
                    count
                    / storage.totalItems
                    * 100
                )
        end

        writeAt(
            legendX,
            legendY,
            name
                .. " "
                .. percent
                .. "%",
            color
        )

        legendX =
            legendX + 15

        if legendX + 14 > w then
            legendX = 2
            legendY =
                legendY + 1
        end
    end

    --------------------------------------------------
    -- HISTORY GRAPH
    --------------------------------------------------

    local graphTitleY =
        legendY + 2

    writeAt(
        2,
        graphTitleY,
        "SLOTS USED - LAST 60 MIN",
        colors.gray
    )

    local graphValue =
        comma(storage.usedSlots)
        .. " / "
        .. comma(storage.totalSlots)

    writeAt(
        w - #graphValue - 1,
        graphTitleY,
        graphValue,
        colors.gray
    )

    local graphY =
        graphTitleY + 1

    local graphHeight = 5

    drawGraph(
        2,
        graphY,
        w - 3,
        graphHeight
    )

    --------------------------------------------------
    -- LOWER PANELS
    --------------------------------------------------

    local bottomY =
        graphY + graphHeight + 1

    local storageX =
        math.floor(w * 0.42)

    local stressListX =
        math.floor(w * 0.72)

    --------------------------------------------------
    -- TOP CONSUMERS
    --------------------------------------------------

    writeAt(
        2,
        bottomY,
        "TOP CONSUMERS",
        colors.gray
    )

    for i, item in ipairs(storage.topItems) do
        local y =
            bottomY + i

        if y >= h - 2 then
            break
        end

        local name =
            cleanName(item.name)

        if #name > 17 then
            name =
                name:sub(1, 17)
        end

        writeAt(
            2,
            y,
            string.format(
                "%-17s",
                name
            ),
            colors.white
        )

        writeAt(
            20,
            y,
            string.format(
                "%7s",
                short(item.count)
            ),
            colors.lightGray
        )

        local highest =
            storage.topItems[1]
            and storage.topItems[1].count
            or 1

        bar(
            28,
            y,
            math.max(
                5,
                storageX - 30
            ),
            item.count
                / math.max(1, highest),
            colors.orange
        )
    end

    --------------------------------------------------
    -- STORAGE NETWORKS
    --------------------------------------------------

    writeAt(
        storageX,
        bottomY,
        "STORAGE NETWORKS",
        colors.gray
    )

    for i, node in ipairs(storage.nodes) do
        local y =
            bottomY + i

        if y >= h - 2 then
            break
        end

        local nodeRatio = 0

        if node.totalSlots > 0 then
            nodeRatio =
                node.usedSlots
                / node.totalSlots
        end

        local name =
            tostring(node.name)

        if #name > 14 then
            name =
                name:sub(1, 14)
        end

        writeAt(
            storageX,
            y,
            string.format(
                "%-14s",
                name
            ),
            colors.white
        )

        local bx =
            storageX + 15

        local bw =
            math.max(
                4,
                stressListX - bx - 5
            )

        bar(
            bx,
            y,
            bw,
            nodeRatio,
            usageColor(nodeRatio)
        )

        writeAt(
            stressListX - 4,
            y,
            math.floor(nodeRatio * 100)
                .. "%",
            nodeRatio >= 0.95
                and colors.red
                or colors.lightGray
        )
    end

    --------------------------------------------------
    -- STRESS NETWORKS
    --------------------------------------------------

    writeAt(
        stressListX,
        bottomY,
        "STRESS NETWORKS",
        colors.gray
    )

    for i, node in ipairs(stress.nodes) do
        local y =
            bottomY + i

        if y >= h - 2 then
            break
        end

        local ratio = 0

        if node.capacity > 0 then
            ratio =
                node.stress
                / node.capacity
        end

        local name =
            tostring(node.name)

        if #name > 12 then
            name =
                name:sub(1, 12)
        end

        writeAt(
            stressListX,
            y,
            string.format(
                "%-12s",
                name
            ),
            colors.white
        )

        local bx =
            stressListX + 13

        local bw =
            math.max(
                4,
                w - bx - 5
            )

        bar(
            bx,
            y,
            bw,
            ratio,
            usageColor(ratio)
        )

        writeAt(
            w - 3,
            y,
            math.floor(ratio * 100)
                .. "%",
            ratio >= 0.95
                and colors.red
                or colors.lightGray
        )
    end

    --------------------------------------------------
    -- ALERTS
    --------------------------------------------------

    local alertY =
        math.max(
            bottomY + 8,
            h - 2
        )

    if alertY < h then
        local alert = nil
        local alertColor =
            colors.orange

        for _, node in ipairs(storage.nodes) do
            local r = 0

            if node.totalSlots > 0 then
                r =
                    node.usedSlots
                    / node.totalSlots
            end

            if r >= 0.95 then
                alert =
                    node.name
                    .. " storage "
                    .. math.floor(r * 100)
                    .. "% full"

                alertColor =
                    colors.red

                break

            elseif r >= 0.85
                and not alert
            then
                alert =
                    node.name
                    .. " storage "
                    .. math.floor(r * 100)
                    .. "% full"
            end
        end

        for _, node in ipairs(stress.nodes) do
            local r = 0

            if node.capacity > 0 then
                r =
                    node.stress
                    / node.capacity
            end

            if r >= 0.95 then
                alert =
                    node.name
                    .. " stress "
                    .. math.floor(r * 100)
                    .. "%"

                alertColor =
                    colors.red

                break

            elseif r >= 0.85
                and not alert
            then
                alert =
                    node.name
                    .. " stress "
                    .. math.floor(r * 100)
                    .. "%"
            end
        end

        if alert then
            writeAt(
                2,
                alertY,
                "ALERT: " .. alert,
                alertColor
            )
        end
    end

    --------------------------------------------------
    -- FOOTER
    --------------------------------------------------

    if storage.activeNodes == 0
        and stress.activeNodes == 0
    then
        writeAt(
            2,
            h,
            "WAITING FOR NODES...",
            colors.red
        )
    else
        writeAt(
            2,
            h,
            "COOK'S STORAGE ONLINE",
            colors.green
        )

        local status =
            storage.activeNodes
            .. " storage / "
            .. stress.activeNodes
            .. " stress"

        writeAt(
            w - #status - 1,
            h,
            status,
            colors.gray
        )
    end
end

--------------------------------------------------
-- RECEIVE ALL WIRELESS DATA
--------------------------------------------------

local function receiveLoop()
    while true do
        local _, sender, message, protocol =
            os.pullEvent("rednet_message")

        if type(message) == "table" then

            if protocol == STORAGE_PROTOCOL
                and message.nodeId
            then

                storageNodes[message.nodeId] = {
                    data = message,
                    lastSeen = os.epoch("utc")
                }

            elseif protocol == STRESS_PROTOCOL
                and message.nodeId
            then

                stressNodes[message.nodeId] = {
                    data = message,
                    lastSeen = os.epoch("utc")
                }
            end
        end
    end
end

--------------------------------------------------
-- REFRESH SCREEN INDEPENDENTLY
--------------------------------------------------

local function refreshLoop()
    while true do
        draw()
        sleep(1)
    end
end

--------------------------------------------------
-- START
--------------------------------------------------

draw()

parallel.waitForAll(
    receiveLoop,
    refreshLoop
)
