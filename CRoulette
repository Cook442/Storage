-- ============================================================
-- PAYOUT FOR ONE BET
-- ============================================================

local function payoutForBet(
    bet,
    n
)

    local t =
        bet.type

    local v =
        bet.value

    --------------------------------------------------
    -- NUMBER
    --------------------------------------------------

    if t == "number" then

        if n == v then

            return
                betAmount
                * 36
        end

    --------------------------------------------------
    -- COLOR
    --------------------------------------------------

    elseif t == "color" then

        if numberColorName(n)
            == v
        then

            return
                betAmount
                * 2
        end

    --------------------------------------------------
    -- ODD / EVEN
    --------------------------------------------------

    elseif t == "parity" then

        if n ~= 0 then

            if v == "ODD"
                and n % 2 == 1
            then

                return
                    betAmount
                    * 2
            end

            if v == "EVEN"
                and n % 2 == 0
            then

                return
                    betAmount
                    * 2
            end
        end

    --------------------------------------------------
    -- 1-18 / 19-36
    --------------------------------------------------

    elseif t == "range" then

        if v == "LOW"
            and n >= 1
            and n <= 18
        then

            return
                betAmount
                * 2
        end

        if v == "HIGH"
            and n >= 19
            and n <= 36
        then

            return
                betAmount
                * 2
        end

    --------------------------------------------------
    -- DOZENS
    --------------------------------------------------

    elseif t == "dozen" then

        local minimum =
            (v - 1)
            * 12
            + 1

        local maximum =
            v
            * 12

        if n >= minimum
            and n <= maximum
        then

            return
                betAmount
                * 3
        end
    end

    return 0
end

local function calculatePayout(n)

    local payout = 0

    for _, bet
        in pairs(bets)
    do

        payout =
            payout
            + payoutForBet(
                bet,
                n
            )
    end

    return payout
end

-- ============================================================
-- SPIN
--
-- IMPORTANT:
-- NO HIDDEN WINNER IS CHOSEN.
--
-- The wheel and ball move.
-- When the ball stops, the number physically underneath the
-- visible ball position becomes the actual result.
-- ============================================================

local function spin()

    if spinning then
        return
    end

    local stake =
        totalStake()

    --------------------------------------------------
    -- VALIDATE BETS
    --------------------------------------------------

    if stake <= 0 then

        message =
            "SELECT AT LEAST ONE BET"

        draw()

        return
    end

    --------------------------------------------------
    -- VALIDATE BALANCE
    --------------------------------------------------

    if credits < stake then

        message =
            "NOT ENOUGH CREDITS"

        draw()

        return
    end

    --------------------------------------------------
    -- TAKE STAKE
    --------------------------------------------------

    credits =
        credits - stake

    spinning =
        true

    resultNumber =
        nil

    winningIndex =
        nil

    message =
        "SPINNING..."

    draw()

    --------------------------------------------------
    -- RANDOMIZE MOTION ONLY
    --------------------------------------------------

    local wheelSteps =
        math.random(
            58,
            85
        )

    local ballSteps =
        math.random(
            75,
            115
        )

    --------------------------------------------------
    -- FAST
    --------------------------------------------------

    local fastSteps = 32

    for i = 1, fastSteps do

        wheelIndex =
            wrapWheel(
                wheelIndex + 1
            )

        ballIndex =
            wrapRing(
                ballIndex - 1
            )

        drawSpinFrame()

        sleep(
            0.035
        )
    end

    --------------------------------------------------
    -- MEDIUM
    --------------------------------------------------

    local mediumSteps = 18

    for i = 1, mediumSteps do

        wheelIndex =
            wrapWheel(
                wheelIndex + 1
            )

        ballIndex =
            wrapRing(
                ballIndex - 1
            )

        drawSpinFrame()

        sleep(
            0.045
            + i * 0.006
        )
    end

    --------------------------------------------------
    -- WHEEL SLOWS
    --------------------------------------------------

    local remainingWheel =
        math.max(
            0,
            wheelSteps
            - fastSteps
            - mediumSteps
        )

    for i = 1, remainingWheel do

        wheelIndex =
            wrapWheel(
                wheelIndex + 1
            )

        ballIndex =
            wrapRing(
                ballIndex - 1
            )

        drawSpinFrame()

        sleep(
            0.10
            + i * 0.012
        )
    end

    --------------------------------------------------
    -- BALL CONTINUES
    --------------------------------------------------

    local remainingBall =
        math.max(
            12,
            ballSteps
            - wheelSteps
        )

    for i = 1, remainingBall do

        ballIndex =
            wrapRing(
                ballIndex - 1
            )

        drawSpinFrame()

        local progress =
            i
            / remainingBall

        local delay =
            0.07
            + progress
            * progress
            * 0.28

        sleep(
            delay
        )
    end

    --------------------------------------------------
    -- SMALL BALL BOUNCES
    --------------------------------------------------

    for i = 1, 4 do

        ballIndex =
            wrapRing(
                ballIndex + 1
            )

        drawSpinFrame()

        sleep(
            0.12
            + i * 0.05
        )
    end

    --------------------------------------------------
    -- FINAL SETTLE
    --------------------------------------------------

    ballIndex =
        wrapRing(
            ballIndex - 1
        )

    drawSpinFrame()

    sleep(
        0.35
    )

    --------------------------------------------------
    -- DETERMINE VISIBLE WINNING POCKET
    --------------------------------------------------

    local visiblePosition =
        wrapRing(
            ballIndex
        )

    local resultIndex =
        wrapWheel(
            wheelIndex
            + visiblePosition
            - 1
        )

    winningIndex =
        resultIndex

    resultNumber =
        wheel[
            resultIndex
        ]

    --------------------------------------------------
    -- ADD TO SEPARATE HISTORY MONITOR
    --------------------------------------------------

    addHistory(
        resultNumber
    )

    --------------------------------------------------
    -- CALCULATE PAYOUT USING EXACT VISIBLE RESULT
    --------------------------------------------------

    local payout =
        calculatePayout(
            resultNumber
        )

    credits =
        credits
        + payout

    spinning =
        false

    --------------------------------------------------
    -- RESULT MESSAGE
    --------------------------------------------------

    if payout > 0 then

        message =
            "WIN +"
            .. payout
            .. " CR"

    else

        message =
            "LOSE -"
            .. stake
            .. " CR"
    end

    --------------------------------------------------
    -- FINAL MAIN SCREEN DRAW
    --------------------------------------------------

    draw()
end

-- ============================================================
-- BET SIZE
-- ============================================================

local function lowerBet()

    if spinning then
        return
    end

    betAmount =
        math.max(
            5,
            betAmount - 5
        )

    message =
        "BET EACH "
        .. betAmount
        .. " CR"

    draw()
end

local function raiseBet()

    if spinning then
        return
    end

    betAmount =
        math.min(
            500,
            betAmount + 5
        )

    message =
        "BET EACH "
        .. betAmount
        .. " CR"

    draw()
end

-- ============================================================
-- TOUCH HANDLER
-- ============================================================

local function handleTouch(
    x,
    y
)

    if spinning then
        return
    end

    --------------------------------------------------
    -- NUMBER BETS
    --------------------------------------------------

    for _, cell
        in ipairs(
            numberCells
        )
    do

        if x >= cell.x1
            and x <= cell.x2
            and y >= cell.y1
            and y <= cell.y2
        then

            toggleBet(
                {
                    type =
                        "number",

                    value =
                        cell.number
                }
            )

            draw()

            return
        end
    end

    --------------------------------------------------
    -- BUTTONS
    --------------------------------------------------

    for name, button
        in pairs(buttons)
    do

        if inside(
            button,
            x,
            y
        )
        then

            if name == "spin" then

                spin()

            elseif name == "deposit" then

                depositDiamonds()

                draw()

            elseif name == "cashout" then

                cashOut()

                draw()

            elseif name == "clear" then

                clearBets()

                draw()

            elseif name == "betDown" then

                lowerBet()

            elseif name == "betUp" then

                raiseBet()

            elseif name == "allin" then

                allIn()

                draw()

            elseif button.data then

                toggleBet(
                    button.data
                )

                draw()
            end

            return
        end
    end
end

