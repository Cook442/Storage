-- ============================================================

local function historyCentered(
    y,
    text,
    color
)

    local hw, hh =
        historyMonitor.getSize()

    text =
        tostring(text)

    if y < 1
        or y > hh
    then

        return
    end

    local x =
        math.floor(
            (hw - #text)
            / 2
        ) + 1

    historyMonitor.setCursorPos(
        x,
        y
    )

    historyMonitor.setTextColor(
        color
        or colors.white
    )

    historyMonitor.setBackgroundColor(
        colors.black
    )

    historyMonitor.write(
        text
    )
end

local function drawHistoryMonitor()

    historyMonitor.setTextScale(
        1
    )

    historyMonitor.setBackgroundColor(
        colors.black
    )

    historyMonitor.clear()

    local hw, hh =
        historyMonitor.getSize()

    --------------------------------------------------
    -- TITLE
    --------------------------------------------------

    historyCentered(
        2,
        "COOK'S ROULETTE",
        colors.yellow
    )

    historyCentered(
        4,
        "RECENT NUMBERS",
        colors.white
    )

    --------------------------------------------------
    -- DIVIDER
    --------------------------------------------------

    local divider =
        "-----------------"

    historyMonitor.setCursorPos(
        math.floor(
            (hw - #divider)
            / 2
        ) + 1,
        5
    )

    historyMonitor.setTextColor(
        colors.gray
    )

    historyMonitor.write(
        divider
    )

    --------------------------------------------------
    -- WAITING
    --------------------------------------------------

    if #history == 0 then

        historyCentered(
            8,
            "WAITING FOR SPIN",
            colors.gray
        )

        return
    end

    --------------------------------------------------
    -- RECENT NUMBERS
    --------------------------------------------------

    local y = 7

    for i, number
        in ipairs(history)
    do

        if i > MAX_HISTORY
            or y > hh
        then

            break
        end

        historyCentered(
            y,
            tostring(number),
            historyColor(number)
        )

        y =
            y + 2
    end
end

-- ============================================================
-- ADD HISTORY RESULT
-- ============================================================

local function addHistory(number)

    table.insert(
        history,
        1,
        number
    )

    while #history
        > MAX_HISTORY
    do

        table.remove(
            history
        )
    end

    drawHistoryMonitor()
end

