local wheelCX =
    math.floor(
        W / 2
    )

local wheelCY = 20

local wheelPositions = {

    {  0,-14},
    {  5,-13},
    { 10,-11},
    { 14, -8},
    { 17, -4},

    { 18,  0},

    { 17,  4},
    { 14,  8},
    { 10, 11},
    {  5, 13},

    {  0, 14},

    { -5, 13},
    {-10, 11},
    {-14,  8},
    {-17,  4},

    {-18,  0},

    {-17, -4},
    {-14, -8},
    {-10,-11},
    { -5,-13}
}

local wheelIndex = 1

local ballIndex = 1

local function wrapWheel(i)

    while i < 1 do

        i =
            i + #wheel
    end

    while i > #wheel do

        i =
            i - #wheel
    end

    return i
end

local function wrapRing(i)

    while i < 1 do

        i =
            i
            + #wheelPositions
    end

    while i >
        #wheelPositions
    do

        i =
            i
            - #wheelPositions
    end

    return i
end

