-- DRAW WHEEL
-- ============================================================

local function drawWheel()

    --------------------------------------------------
    -- WALNUT OUTER FRAME
    --------------------------------------------------

    for y = 5, 35 do

        fill(
            5,
            y,
            W - 9,
            colors.brown
        )
    end

    --------------------------------------------------
    -- GOLD TRIM
    --------------------------------------------------

    for y = 6, 34 do

        fill(
            6,
            y,
            W - 11,
            colors.yellow
        )
    end

    --------------------------------------------------
    -- EMERALD WHEEL
    --------------------------------------------------

    for y = 7, 33 do

        fill(
            7,
            y,
            W - 13,
            colors.green
        )
    end

    --------------------------------------------------
    -- BLACK CENTER
    --------------------------------------------------

    for y = 13, 27 do

        fill(
            15,
            y,
            W - 29,
            colors.black
        )
    end

    --------------------------------------------------
    -- CENTER HUB
    --------------------------------------------------

    for y =
        wheelCY - 2,
        wheelCY + 2
    do

        fill(
            wheelCX - 3,
            y,
            7,
            colors.orange
        )
    end

    writeAt(
        wheelCX,
        wheelCY,
        "*",
        colors.yellow,
        colors.orange
    )

    --------------------------------------------------
    -- NUMBER POCKETS
    --------------------------------------------------

    for i, pos
        in ipairs(
            wheelPositions
        )
    do

        local idx =
            wrapWheel(
                wheelIndex
                + i
                - 1
            )

        local n =
            wheel[idx]

        local x =
            wheelCX
            + pos[1]

        local y =
            wheelCY
            + pos[2]

        local bg =
            numberColor(n)

        local fg =
            colors.white

        if winningIndex
            and idx
                == winningIndex
            and not spinning
        then

            bg =
                colors.yellow

            fg =
                colors.black
        end

        local text =
            tostring(n)

        if #text == 2 then

            x =
                x - 1
        end

        writeAt(
            x,
            y,
            text,
            fg,
            bg
        )
    end

    --------------------------------------------------
    -- WHITE BALL
    --------------------------------------------------

    local bp =
        wheelPositions[
            wrapRing(
                ballIndex
            )
        ]

    writeAt(
        wheelCX + bp[1],
        wheelCY + bp[2],
        "O",
        colors.black,
        colors.white
    )
end

