-- ============================================================
-- NUMBER GRID
-- ============================================================

local numberCells = {}

local GRID_Y = 43

local CELL_W = 4

local CELL_H = 2

local function setupNumberGrid()

    numberCells = {}

    --------------------------------------------------
    -- ZERO
    --------------------------------------------------

    table.insert(
        numberCells,
        {
            number = 0,

            x1 = 2,
            y1 = GRID_Y,

            x2 = 5,
            y2 = GRID_Y + 5
        }
    )

    --------------------------------------------------
    -- 1-36
    --------------------------------------------------

    local n = 1

    for col = 1, 12 do

        for row = 1, 3 do

            local x =
                6
                + (col - 1)
                * CELL_W

            local y =
                GRID_Y
                + (3 - row)
                * CELL_H

            table.insert(
                numberCells,
                {
                    number = n,

                    x1 = x,
                    y1 = y,

                    x2 =
                        x + CELL_W - 1,

                    y2 =
                        y + CELL_H - 1
                }
            )

            n =
                n + 1
        end
    end
end

setupNumberGrid()

local function drawNumberGrid()

    for _, cell
        in ipairs(
            numberCells
        )
    do

        local data = {

            type =
                "number",

            value =
                cell.number
        }

        local selected =
            isBetSelected(
                data
            )

        local bg =

            selected
            and colors.yellow
            or numberColor(
                cell.number
            )

        local fg =

            selected
            and colors.black
            or colors.white

        for y =
            cell.y1,
            cell.y2
        do

            fill(
                cell.x1,
                y,
                cell.x2
                - cell.x1
                + 1,
                bg
            )
        end

        local text =
            tostring(
                cell.number
            )

        local cx =
            math.floor(
                (
                    cell.x1
                    + cell.x2
                    - #text
                    + 1
                ) / 2
            )

        local cy =
            math.floor(
                (
                    cell.y1
                    + cell.y2
                ) / 2
            )

        writeAt(
            cx,
            cy,
            text,
            fg,
            bg
        )
    end
end

