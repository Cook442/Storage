-- ============================================================
-- MAIN DRAW HELPERS
-- ============================================================

local function writeAt(
    x,
    y,
    text,
    fg,
    bg
)

    x =
        math.floor(x)

    y =
        math.floor(y)

    text =
        tostring(text)

    if x < 1
        or y < 1
        or x > W
        or y > H
    then

        return
    end

    if #text >
        W - x + 1
    then

        text =
            text:sub(
                1,
                W - x + 1
            )
    end

    monitor.setCursorPos(
        x,
        y
    )

    monitor.setTextColor(
        fg
        or colors.white
    )

    monitor.setBackgroundColor(
        bg
        or colors.black
    )

    monitor.write(
        text
    )
end

local function fill(
    x,
    y,
    width,
    color
)

    x =
        math.floor(x)

    y =
        math.floor(y)

    width =
        math.floor(width)

    if x < 1
        or y < 1
        or y > H
        or width <= 0
    then

        return
    end

    width =
        math.min(
            width,
            W - x + 1
        )

    monitor.setCursorPos(
        x,
        y
    )

    monitor.setBackgroundColor(
        color
    )

    monitor.write(
        string.rep(
            " ",
            width
        )
    )
end

local function centered(
    y,
    text,
    fg,
    bg
)

    text =
        tostring(text)

    local x =
        math.floor(
            (W - #text)
            / 2
        ) + 1

    writeAt(
        x,
        y,
        text,
        fg,
        bg
    )
end

local function clear()

    monitor.setBackgroundColor(
        colors.black
    )

    monitor.clear()
end

-- ============================================================
