local buttons = {}

local function addButton(
    name,
    x1,
    y1,
    x2,
    y2,
    text,
    color,
    data
)

    buttons[name] = {

        x1 = x1,
        y1 = y1,

        x2 = x2,
        y2 = y2,

        text = text,

        color = color,

        data = data
    }
end

local function inside(
    button,
    x,
    y
)

    return

        x >= button.x1
        and x <= button.x2

        and y >= button.y1
        and y <= button.y2
end

local function drawButton(
    button,
    selected
)

    local bg =

        selected
        and colors.yellow
        or button.color

    local fg =

        selected
        and colors.black
        or colors.white

    for y =
        button.y1,
        button.y2
    do

        fill(
            button.x1,
            y,
            button.x2
            - button.x1
            + 1,
            bg
        )
    end

    local cx =
        math.floor(
            (
                button.x1
                + button.x2
                - #button.text
                + 1
            ) / 2
        )

    local cy =
        math.floor(
            (
                button.y1
                + button.y2
            ) / 2
        )

    writeAt(
        cx,
        cy,
        button.text,
        fg,
        bg
    )
end

-- ============================================================
-- BET SYSTEM
-- ============================================================

local function betKey(data)

    return

        tostring(
            data.type
        )

        .. ":"

        .. tostring(
            data.value
        )
end

local function isBetSelected(data)

    return

        bets[
            betKey(data)
        ] ~= nil
end

local function betCount()

    local count = 0

    for _
        in pairs(bets)
    do

        count =
            count + 1
    end

    return count
end

local function totalStake()

    return

        betCount()
        * betAmount
end

local function toggleBet(data)

    if spinning then
        return
    end

    local key =
        betKey(data)

    if bets[key] then

        bets[key] =
            nil

    else

        bets[key] = {

            type =
                data.type,

            value =
                data.value
        }
    end

    message =

        betCount()
        .. " BETS SELECTED"
end

local function clearBets()

    if spinning then
        return
    end

    bets = {}

    message =
        "BETS CLEARED"
end

-- ============================================================
-- ALL IN
-- ============================================================

local function allIn()

    if spinning then
        return
    end

    local count =
        betCount()

    if count <= 0 then

        message =
            "SELECT BETS BEFORE ALL IN"

        return
    end

    if credits <= 0 then

        message =
            "NO CREDITS TO BET"

        return
    end

    betAmount =
        math.floor(
            credits
            / count
        )

    if betAmount <= 0 then

        message =
            "NOT ENOUGH FOR ALL BETS"

        return
    end

    message =
        "ALL IN "
        .. totalStake()
        .. " CR"
end

-- ============================================================
-- DIAMOND HELPERS
-- ============================================================

local function countDiamonds(inv)

    local total = 0

    for _, item
        in pairs(
            inv.list()
        )
    do

        if item.name
            == DIAMOND
        then

            total =
                total
                + item.count
        end
    end

    return total
end

local function houseDiamonds()

    return
        countDiamonds(
            bankChest
        )
end

local function playerDiamonds()

    return
        countDiamonds(
            playerChest
        )
end

-- ============================================================
-- SECURE DEPOSIT
-- ============================================================

local function depositDiamonds()

    if spinning then
        return
    end

    local movedTotal = 0

    for slot, item
        in pairs(
            playerChest.list()
        )
    do

        if item.name
            == DIAMOND
        then

            --------------------------------------------------
            -- PHYSICALLY MOVE DIAMONDS FIRST
            --------------------------------------------------

            local moved =
                playerChest.pushItems(
                    BANK_CHEST,
                    slot,
                    item.count
                )

            movedTotal =
                movedTotal
                + moved
        end
    end

    --------------------------------------------------
    -- ONLY ISSUE CREDITS FOR DIAMONDS THAT MOVED
    --------------------------------------------------

    if movedTotal > 0 then

        local added =
            movedTotal
            * DIAMOND_VALUE

        credits =
            credits
            + added

        message =
            "+"
            .. added
            .. " CR | "
            .. movedTotal
            .. " DIAMONDS BANKED"

    else

        if playerDiamonds()
            > 0
        then

            message =
                "HOUSE BANK FULL"

        else

            message =
                "NO DIAMONDS TO DEPOSIT"
        end
    end
end

-- ============================================================
-- SECURE CASHOUT
-- ============================================================

local function cashOut()

    if spinning then
        return
    end

    local wanted =
        math.floor(
            credits
            / DIAMOND_VALUE
        )

    if wanted <= 0 then

        message =
            "NEED 100 CR TO CASH OUT"

        return
    end

    local remaining =
        wanted

    local movedTotal =
        0

    for slot, item
        in pairs(
            bankChest.list()
        )
    do

        if remaining <= 0 then
            break
        end

        if item.name
            == DIAMOND
        then

            local request =
                math.min(
                    item.count,
                    remaining
                )

            --------------------------------------------------
            -- PHYSICALLY PAY DIAMONDS FIRST
            --------------------------------------------------

            local moved =
                bankChest.pushItems(
                    PLAYER_CHEST,
                    slot,
                    request
                )

            movedTotal =
                movedTotal
                + moved

            remaining =
                remaining
                - moved
        end
    end

    --------------------------------------------------
    -- ONLY REMOVE CREDITS FOR DIAMONDS ACTUALLY PAID
    --------------------------------------------------

    if movedTotal > 0 then

        local paidCredits =
            movedTotal
            * DIAMOND_VALUE

        credits =
            credits
            - paidCredits

        message =
            "PAID "
            .. movedTotal
            .. " DIAMONDS"

    else

        if houseDiamonds()
            <= 0
        then

            message =
                "HOUSE BANK EMPTY"

        else

            message =
                "PAYOUT CHEST FULL"
        end
    end
end

