--------------------------------------------------

local wheel = {
    0,32,15,19,4,21,2,25,17,34,6,27,13,36,11,30,
    8,23,10,5,24,16,33,1,20,14,31,9,22,18,29,7,
    28,12,35,3,26
}

local redNumbers = {
    [1]=true,[3]=true,[5]=true,[7]=true,[9]=true,
    [12]=true,[14]=true,[16]=true,[18]=true,
    [19]=true,[21]=true,[23]=true,[25]=true,[27]=true,
    [30]=true,[32]=true,[34]=true,[36]=true
}

local function numberColorName(n)
    if n == 0 then
        return "GREEN"
    elseif redNumbers[n] then
        return "RED"
    else
        return "BLACK"
    end
end

local function numberColor(n)
    if n == 0 then
        return colors.green
    elseif redNumbers[n] then
        return colors.red
    else
        return colors.black
    end
end

--------------------------------------------------
-- DRAW HELPERS
--------------------------------------------------

local function writeAt(x, y, text, fg, bg)
    x = math.floor(x)
    y = math.floor(y)

    if x < 1 or y < 1 or x > W or y > H then
        return
    end

    text = tostring(text)

    if #text > W - x + 1 then
        text = text:sub(1, W - x + 1)
    end

    monitor.setCursorPos(x, y)
    monitor.setTextColor(fg or colors.white)
    monitor.setBackgroundColor(bg or colors.black)
    monitor.write(text)
end

local function fill(x, y, width, color)
    x = math.floor(x)
    y = math.floor(y)
    width = math.floor(width)

    if width <= 0 then
        return
    end

    width = math.min(width, W - x + 1)

    monitor.setCursorPos(x, y)
    monitor.setBackgroundColor(color)
    monitor.write(string.rep(" ", width))
end

local function clear()
    monitor.setBackgroundColor(colors.black)
    monitor.clear()
end

local function centered(y, text, fg, bg)
    local x = math.floor((W - #text) / 2) + 1
    writeAt(x, y, text, fg, bg)
end

--------------------------------------------------
-- BUTTONS
--------------------------------------------------

local buttons = {}

local function addButton(name, x1, y1, x2, y2, text, color, data)
    buttons[name] = {
        x1 = x1,
        y1 = y1,
        x2 = x2,
        y2 = y2,
        text = text,
        color = color,
        data = data
    }
end

local function inside(b, x, y)
    return
        x >= b.x1 and x <= b.x2
        and y >= b.y1 and y <= b.y2
end

local function drawButton(b, selected)
    local bg = selected and colors.yellow or b.color
    local fg = selected and colors.black or colors.white

    for y = b.y1, b.y2 do
        fill(
            b.x1,
            y,
            b.x2 - b.x1 + 1,
            bg
        )
    end

    local cx =
        math.floor(
            (b.x1 + b.x2 - #b.text + 1) / 2
        )

    local cy =
        math.floor(
            (b.y1 + b.y2) / 2
        )

    writeAt(
        cx,
        cy,
        b.text,
        fg,
        bg
    )
end

