--------------------------------------------------
-- WHEEL VISUAL
--------------------------------------------------

local wheelCenterX = 15
local wheelCenterY = 12

local ringPositions = {
    { 0,-7},
    { 4,-6},
    { 7,-4},
    { 8, 0},
    { 7, 4},
    { 4, 6},
    { 0, 7},
    {-4, 6},
    {-7, 4},
    {-8, 0},
    {-7,-4},
    {-4,-6}
}

local wheelIndex = 1
local ballIndex = 1

local function wrapWheel(i)
    while i < 1 do
        i = i + #wheel
    end

    while i > #wheel do
        i = i - #wheel
    end

    return i
end

local function wrapRing(i)
    while i < 1 do
        i = i + #ringPositions
    end

    while i > #ringPositions do
        i = i - #ringPositions
    end

    return i
end

local function drawWheel()

    --------------------------------------------------
    -- OUTER WOOD
    --------------------------------------------------

    for y = 5, 19 do
        fill(
            4,
            y,
            23,
            colors.brown
        )
    end

    --------------------------------------------------
    -- INNER GREEN BOWL
    --------------------------------------------------

    for y = 6, 18 do
        fill(
            5,
            y,
            21,
            colors.green
        )
    end

    --------------------------------------------------
    -- DARK CENTER
    --------------------------------------------------

    for y = 9, 15 do
        fill(
            10,
            y,
            11,
            colors.black
        )
    end

    --------------------------------------------------
    -- NUMBER POCKETS
    --------------------------------------------------

    for i, pos in ipairs(ringPositions) do
        local idx =
            wrapWheel(
                wheelIndex + i - 1
            )

        local n =
            wheel[idx]

        local x =
            wheelCenterX + pos[1]

        local y =
            wheelCenterY + pos[2]

        local txt =
            tostring(n)

        local bg =
            numberColor(n)

        if #txt == 1 then
            writeAt(
                x,
                y,
                txt,
                colors.white,
                bg
            )
        else
            writeAt(
                x - 1,
                y,
                txt,
                colors.white,
                bg
            )
        end
    end

    --------------------------------------------------
    -- CENTER DECORATION
    --------------------------------------------------

    writeAt(
        wheelCenterX - 1,
        wheelCenterY - 1,
        "o",
        colors.yellow,
        colors.black
    )

    writeAt(
        wheelCenterX + 1,
        wheelCenterY,
        "o",
        colors.yellow,
        colors.black
    )

    writeAt(
        wheelCenterX - 1,
        wheelCenterY + 1,
        "o",
        colors.yellow,
        colors.black
    )

    --------------------------------------------------
    -- BALL
    --------------------------------------------------

    local ballPos =
        ringPositions[
            wrapRing(ballIndex)
        ]

    local bx =
        wheelCenterX + ballPos[1]

    local by =
        wheelCenterY + ballPos[2]

    writeAt(
        bx,
        by,
        "O",
        colors.black,
        colors.white
    )
end

