--------------------------------------------------
-- EUROPEAN WHEEL
--------------------------------------------------

local wheel = {
    0,32,15,19,4,21,2,25,17,34,6,27,13,36,11,30,
    8,23,10,5,24,16,33,1,20,14,31,9,22,18,29,7,
    28,12,35,3,26
}

local reds = {
    [1]=true,[3]=true,[5]=true,[7]=true,[9]=true,
    [12]=true,[14]=true,[16]=true,[18]=true,
    [19]=true,[21]=true,[23]=true,[25]=true,[27]=true,
    [30]=true,[32]=true,[34]=true,[36]=true
}

local function numberColor(n)
    if n == 0 then
        return colors.green
    elseif reds[n] then
        return colors.red
    else
        return colors.black
    end
end

local function numberColorName(n)
    if n == 0 then
        return "GREEN"
    elseif reds[n] then
        return "RED"
    else
        return "BLACK"
    end
end

--------------------------------------------------
-- DRAW HELPERS
--------------------------------------------------

local function writeAt(x, y, text, fg, bg)
    x = math.floor(x)
    y = math.floor(y)

    if x < 1 or y < 1 or x > W or y > H then
        return
    end

    text = tostring(text)

    if #text > W - x + 1 then
        text = text:sub(1, W - x + 1)
    end

    monitor.setCursorPos(x, y)
    monitor.setTextColor(fg or colors.white)
    monitor.setBackgroundColor(bg or colors.black)
    monitor.write(text)
end

local function fill(x, y, width, color)
    x = math.floor(x)
    y = math.floor(y)
    width = math.floor(width)

    if width <= 0 then
        return
    end

    width = math.min(width, W - x + 1)

    monitor.setCursorPos(x, y)
    monitor.setBackgroundColor(color)
    monitor.write(string.rep(" ", width))
end

local function clear()
    monitor.setBackgroundColor(colors.black)
    monitor.clear()
end

local function centered(y, text, fg, bg)
    local x = math.floor((W - #text) / 2) + 1
    writeAt(x, y, text, fg, bg)
end

--------------------------------------------------
-- BUTTONS
--------------------------------------------------

local buttons = {}

local function addButton(name, x1, y1, x2, y2, text, color, data)
    buttons[name] = {
        x1 = x1,
        y1 = y1,
        x2 = x2,
        y2 = y2,
        text = text,
        color = color,
        data = data
    }
end

local function inside(b, x, y)
    return
        x >= b.x1 and x <= b.x2
        and y >= b.y1 and y <= b.y2
end

local function drawButton(b, selected)
    local bg = selected and colors.yellow or b.color
    local fg = selected and colors.black or colors.white

    for y = b.y1, b.y2 do
        fill(
            b.x1,
            y,
            b.x2 - b.x1 + 1,
            bg
        )
    end

    local cx =
        math.floor(
            (b.x1 + b.x2 - #b.text + 1) / 2
        )

    local cy =
        math.floor(
            (b.y1 + b.y2) / 2
        )

    writeAt(
        cx,
        cy,
        b.text,
        fg,
        bg
    )
end

--------------------------------------------------
-- BET HELPERS
--------------------------------------------------

local function betKey(data)
    return
        tostring(data.type)
        .. ":"
        .. tostring(data.value)
end

local function isBetSelected(data)
    return bets[betKey(data)] ~= nil
end

local function toggleBet(data)
    if spinning then
        return
    end

    local key =
        betKey(data)

    if bets[key] then
        bets[key] = nil
    else
        bets[key] = {
            type = data.type,
            value = data.value
        }
    end
end

local function betCount()
    local count = 0

    for _ in pairs(bets) do
        count = count + 1
    end

    return count
end

local function totalStake()
    return
        betCount()
        * betAmount
end

local function clearBets()
    if spinning then
        return
    end

    bets = {}

    message =
        "BETS CLEARED"
end

--------------------------------------------------
-- LARGE WHEEL
--------------------------------------------------

local wheelCX =
    math.floor(W / 2)

local wheelCY = 21

local wheelPositions = {
    {  0,-15},
    {  5,-14},
    { 10,-12},
    { 14, -9},
    { 17, -5},
    { 18,  0},
    { 17,  5},
    { 14,  9},
    { 10, 12},
    {  5, 14},
    {  0, 15},
    { -5, 14},
    {-10, 12},
    {-14,  9},
    {-17,  5},
    {-18,  0},
    {-17, -5},
    {-14, -9},
    {-10,-12},
    { -5,-14}
}

local wheelIndex = 1
local ballIndex = 1
local winningIndex = nil

local function wrapWheel(i)
    while i < 1 do
        i = i + #wheel
    end

    while i > #wheel do
        i = i - #wheel
    end

    return i
end

local function wrapRing(i)
    while i < 1 do
        i = i + #wheelPositions
    end

    while i > #wheelPositions do
        i = i - #wheelPositions
    end

    return i
end

--------------------------------------------------
-- DRAW WHEEL
--------------------------------------------------

local function drawWheel()

    --------------------------------------------------
    -- WOOD
    --------------------------------------------------

    for y = 5, 37 do
        fill(
            5,
            y,
            W - 9,
            colors.brown
        )
    end

    --------------------------------------------------
    -- BOWL
    --------------------------------------------------

    for y = 7, 35 do
        fill(
            7,
            y,
            W - 13,
            colors.green
        )
    end

    --------------------------------------------------
    -- DARK CENTER
    --------------------------------------------------

    for y = 13, 29 do
        fill(
            15,
            y,
            W - 29,
            colors.black
        )
    end

    --------------------------------------------------
    -- CENTER HUB
    --------------------------------------------------

    for y = wheelCY - 2, wheelCY + 2 do
        fill(
            wheelCX - 3,
            y,
            7,
            colors.orange
        )
    end

    writeAt(
        wheelCX - 1,
        wheelCY,
        "O",
        colors.yellow,
        colors.orange
    )

    --------------------------------------------------
    -- POCKET NUMBERS
    --------------------------------------------------

    for i, pos in ipairs(wheelPositions) do

        local idx =
            wrapWheel(
                wheelIndex + i - 1
            )

        local n =
            wheel[idx]

        local x =
            wheelCX + pos[1]

        local y =
            wheelCY + pos[2]

        local bg =
            numberColor(n)

        local fg =
            colors.white

        if winningIndex
            and idx == winningIndex
            and not spinning
        then
            bg =
                colors.yellow

            fg =
                colors.black
        end

        local text =
            tostring(n)

        if #text == 1 then

            writeAt(
                x,
                y,
                text,
                fg,
                bg
            )

        else

            writeAt(
                x - 1,
                y,
                text,
                fg,
                bg
            )
        end
    end

    --------------------------------------------------
    -- BALL
    --------------------------------------------------

    local bp =
        wheelPositions[
            wrapRing(ballIndex)
        ]

    writeAt(
        wheelCX + bp[1],
        wheelCY + bp[2],
        "O",
        colors.black,
        colors.white
    )
end

