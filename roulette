--------------------------------------------------
-- DRAW CURRENT PAGE
--------------------------------------------------

local function draw()

    if page == "main" then
        drawMainPage()
    else
        drawBetPage()
    end
end

--------------------------------------------------
-- BET LABEL
--------------------------------------------------

local function betLabel(data)

    if data.type == "number" then
        return "NUMBER " .. data.value

    elseif data.type == "color" then
        return data.value

    elseif data.type == "parity" then
        return data.value

    elseif data.type == "range" then
        return
            data.value == "LOW"
            and "1-18"
            or "19-36"

    elseif data.type == "dozen" then

        if data.value == 1 then
            return "1-12"
        elseif data.value == 2 then
            return "13-24"
        else
            return "25-36"
        end
    end

    return "BET"
end

--------------------------------------------------
-- SELECT BET
--------------------------------------------------

local function selectBet(data)

    if spinning then
        return
    end

    selectedBet = data
    selectedLabel = betLabel(data)

    draw()
end

--------------------------------------------------
-- PAYOUT
--------------------------------------------------

local function calculatePayout(n)

    if not selectedBet then
        return 0
    end

    local t =
        selectedBet.type

    local v =
        selectedBet.value

    if t == "number" then

        if n == v then
            return betAmount * 36
        end

    elseif t == "color" then

        if numberColorName(n) == v then
            return betAmount * 2
        end

    elseif t == "parity" then

        if n ~= 0 then

            if v == "ODD"
                and n % 2 == 1
            then
                return betAmount * 2
            end

            if v == "EVEN"
                and n % 2 == 0
            then
                return betAmount * 2
            end
        end

    elseif t == "range" then

        if v == "LOW"
            and n >= 1
            and n <= 18
        then
            return betAmount * 2
        end

        if v == "HIGH"
            and n >= 19
            and n <= 36
        then
            return betAmount * 2
        end

    elseif t == "dozen" then

        local min =
            (v - 1) * 12 + 1

        local max =
            v * 12

        if n >= min
            and n <= max
        then
            return betAmount * 3
        end
    end

    return 0
end

--------------------------------------------------
-- SPIN ANIMATION
--------------------------------------------------

local function spin()

    if spinning then
        return
    end

    if not selectedBet then

        message =
            "PLACE A BET FIRST"

        draw()

        return
    end

    if credits < betAmount then

        message =
            "NOT ENOUGH CREDITS"

        draw()

        return
    end

    credits =
        credits - betAmount

    spinning = true
    resultNumber = nil
    message = ""

    --------------------------------------------------
    -- PICK WINNER
    --------------------------------------------------

    local targetIndex =
        math.random(
            1,
            #wheel
        )

    local winningNumber =
        wheel[targetIndex]

    --------------------------------------------------
    -- FAST SPIN
    --------------------------------------------------

    for frame = 1, 35 do

        wheelIndex =
            wrapWheel(
                wheelIndex + 1
            )

        ballIndex =
            wrapRing(
                ballIndex - 1
            )

        drawMainPage()

        sleep(
            0.025
            + frame * 0.0015
        )
    end

    --------------------------------------------------
    -- MEDIUM
    --------------------------------------------------

    for frame = 1, 20 do

        wheelIndex =
            wrapWheel(
                wheelIndex + 1
            )

        ballIndex =
            wrapRing(
                ballIndex - 1
            )

        drawMainPage()

        sleep(
            0.06
            + frame * 0.006
        )
    end

    --------------------------------------------------
    -- SLOW WHEEL INTO RESULT
    --------------------------------------------------

    while wheelIndex ~= targetIndex do

        wheelIndex =
            wrapWheel(
                wheelIndex + 1
            )

        drawMainPage()

        sleep(0.12)
    end

    --------------------------------------------------
    -- BALL BOUNCES
    --------------------------------------------------

    for i = 1, 7 do

        ballIndex =
            wrapRing(
                ballIndex + 1
            )

        drawMainPage()

        sleep(
            0.12
            + i * 0.03
        )
    end

    --------------------------------------------------
    -- RESULT
    --------------------------------------------------

    resultNumber =
        winningNumber

    local payout =
        calculatePayout(
            winningNumber
        )

    credits =
        credits + payout

    if payout > 0 then

        message =
            "WIN +"
            .. payout

    else

        message =
            "LOSE"
    end

    spinning = false

    drawMainPage()
end

--------------------------------------------------
-- BET AMOUNT
--------------------------------------------------

local function lowerBet()

    if spinning then
        return
    end

    betAmount =
        math.max(
            5,
            betAmount - 5
        )

    draw()
end

local function raiseBet()

    if spinning then
        return
    end

    betAmount =
        math.min(
            100,
            betAmount + 5
        )

    draw()
end

--------------------------------------------------
-- MAIN PAGE TOUCH
--------------------------------------------------

local function handleMainTouch(x, y)

    if inside(
        buttons.placeBet,
        x,
        y
    ) then

        page = "bet"
        draw()

        return
    end

    if inside(
        buttons.spin,
        x,
        y
    ) then

        spin()

        return
    end

    if inside(
        buttons.betDown,
        x,
        y
    ) then

        lowerBet()

        return
    end

    if inside(
        buttons.betUp,
        x,
        y
    ) then

        raiseBet()

        return
    end
end

--------------------------------------------------
-- BET PAGE TOUCH
--------------------------------------------------

local function handleBetTouch(x, y)

    --------------------------------------------------
    -- NUMBERS
    --------------------------------------------------

    for _, cell in ipairs(numberCells) do

        if x >= cell.x1
            and x <= cell.x2
            and y >= cell.y1
            and y <= cell.y2
        then

            selectBet(
                {
                    type = "number",
                    value = cell.number
                }
            )

            return
        end
    end

    --------------------------------------------------
    -- OPTIONS
    --------------------------------------------------

    for name, button in pairs(buttons) do

        if button.data
            and inside(
                button,
                x,
                y
            )
        then

            selectBet(
                button.data
            )

            return
        end
    end

    --------------------------------------------------
    -- CONFIRM
    --------------------------------------------------

    if inside(
        buttons.confirm,
        x,
        y
    ) then

        page = "main"

        if selectedBet then
            message =
                "READY TO SPIN"
        else
            message =
                "PLACE A BET"
        end

        draw()

        return
    end
end

