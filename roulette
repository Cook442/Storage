--------------------------------------------------
-- BET LABEL
--------------------------------------------------

local function betLabel(data)

    if data.type == "number" then
        return "BETTING NUMBER "
            .. data.value

    elseif data.type == "color" then
        return "BETTING "
            .. data.value

    elseif data.type == "parity" then
        return "BETTING "
            .. data.value

    elseif data.type == "range" then

        return
            data.value == "LOW"
            and "BETTING 1-18"
            or "BETTING 19-36"

    elseif data.type == "dozen" then

        if data.value == 1 then
            return "BETTING 1-12"

        elseif data.value == 2 then
            return "BETTING 13-24"

        else
            return "BETTING 25-36"
        end
    end

    return "BET"
end

--------------------------------------------------
-- SELECT BET
--------------------------------------------------

local function selectBet(data)

    if spinning then
        return
    end

    selectedBet =
        data

    selectedLabel =
        betLabel(data)

    message =
        "READY TO SPIN"

    draw()
end

--------------------------------------------------
-- PAYOUT
--------------------------------------------------

local function calculatePayout(n)

    if not selectedBet then
        return 0
    end

    local t =
        selectedBet.type

    local v =
        selectedBet.value

    --------------------------------------------------
    -- NUMBER
    --------------------------------------------------

    if t == "number" then

        if n == v then
            return betAmount * 36
        end

    --------------------------------------------------
    -- COLOR
    --------------------------------------------------

    elseif t == "color" then

        if numberColorName(n) == v then
            return betAmount * 2
        end

    --------------------------------------------------
    -- ODD / EVEN
    --------------------------------------------------

    elseif t == "parity" then

        if n ~= 0 then

            if v == "ODD"
                and n % 2 == 1
            then
                return betAmount * 2
            end

            if v == "EVEN"
                and n % 2 == 0
            then
                return betAmount * 2
            end
        end

    --------------------------------------------------
    -- LOW / HIGH
    --------------------------------------------------

    elseif t == "range" then

        if v == "LOW"
            and n >= 1
            and n <= 18
        then
            return betAmount * 2
        end

        if v == "HIGH"
            and n >= 19
            and n <= 36
        then
            return betAmount * 2
        end

    --------------------------------------------------
    -- DOZENS
    --------------------------------------------------

    elseif t == "dozen" then

        local min =
            (v - 1) * 12 + 1

        local max =
            v * 12

        if n >= min
            and n <= max
        then
            return betAmount * 3
        end
    end

    return 0
end

--------------------------------------------------
-- SPIN ANIMATION
--------------------------------------------------

local function spin()

    if spinning then
        return
    end

    if not selectedBet then

        message =
            "SELECT A BET FIRST"

        draw()

        return
    end

    if credits < betAmount then

        message =
            "NOT ENOUGH CREDITS"

        draw()

        return
    end

    credits =
        credits - betAmount

    spinning = true
    resultNumber = nil
    winningIndex = nil

    message =
        "SPINNING..."

    --------------------------------------------------
    -- PICK RESULT
    --------------------------------------------------

    local targetIndex =
        math.random(
            1,
            #wheel
        )

    local targetNumber =
        wheel[targetIndex]

    --------------------------------------------------
    -- FAST
    --------------------------------------------------

    for frame = 1, 45 do

        wheelIndex =
            wrapWheel(
                wheelIndex + 1
            )

        ballIndex =
            wrapRing(
                ballIndex - 1
            )

        draw()

        sleep(
            0.02
            + frame * 0.001
        )
    end

    --------------------------------------------------
    -- MEDIUM
    --------------------------------------------------

    for frame = 1, 25 do

        wheelIndex =
            wrapWheel(
                wheelIndex + 1
            )

        ballIndex =
            wrapRing(
                ballIndex - 1
            )

        draw()

        sleep(
            0.055
            + frame * 0.005
        )
    end

    --------------------------------------------------
    -- SLOW WHEEL
    --------------------------------------------------

    while wheelIndex ~= targetIndex do

        wheelIndex =
            wrapWheel(
                wheelIndex + 1
            )

        ballIndex =
            wrapRing(
                ballIndex - 1
            )

        draw()

        sleep(0.11)
    end

    --------------------------------------------------
    -- BALL BOUNCES
    --------------------------------------------------

    for i = 1, 12 do

        ballIndex =
            wrapRing(
                ballIndex + 1
            )

        draw()

        sleep(
            0.08
            + i * 0.025
        )
    end

    --------------------------------------------------
    -- FINAL
    --------------------------------------------------

    winningIndex =
        targetIndex

    resultNumber =
        targetNumber

    local payout =
        calculatePayout(
            targetNumber
        )

    credits =
        credits + payout

    if payout > 0 then

        message =
            "WIN +"
            .. payout

    else

        message =
            "LOSE"
    end

    spinning =
        false

    draw()
end

--------------------------------------------------
-- BET AMOUNT
--------------------------------------------------

local function lowerBet()

    if spinning then
        return
    end

    betAmount =
        math.max(
            5,
            betAmount - 5
        )

    draw()
end

local function raiseBet()

    if spinning then
        return
    end

    betAmount =
        math.min(
            100,
            betAmount + 5
        )

    draw()
end

--------------------------------------------------
-- TOUCH
--------------------------------------------------

local function handleTouch(x, y)

    if spinning then
        return
    end

    --------------------------------------------------
    -- NUMBER GRID
    --------------------------------------------------

    for _, cell in ipairs(numberCells) do

        if x >= cell.x1
            and x <= cell.x2
            and y >= cell.y1
            and y <= cell.y2
        then

            selectBet(
                {
                    type = "number",
                    value = cell.number
                }
            )

            return
        end
    end

    --------------------------------------------------
    -- OTHER BUTTONS
    --------------------------------------------------

    for name, button in pairs(buttons) do

        if inside(
            button,
            x,
            y
        ) then

            if name == "spin" then

                spin()

            elseif name == "betDown" then

                lowerBet()

            elseif name == "betUp" then

                raiseBet()

            elseif button.data then

                selectBet(
                    button.data
                )
            end

            return
        end
    end
end

