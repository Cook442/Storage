--------------------------------------------------
-- PAYOUT FOR ONE BET
--------------------------------------------------

local function payoutForBet(bet, n)

    local t =
        bet.type

    local v =
        bet.value

    --------------------------------------------------
    -- NUMBER
    --------------------------------------------------

    if t == "number" then

        if n == v then
            return
                betAmount * 36
        end

    --------------------------------------------------
    -- COLOR
    --------------------------------------------------

    elseif t == "color" then

        if numberColorName(n) == v then
            return
                betAmount * 2
        end

    --------------------------------------------------
    -- PARITY
    --------------------------------------------------

    elseif t == "parity" then

        if n ~= 0 then

            if v == "ODD"
                and n % 2 == 1
            then

                return
                    betAmount * 2
            end

            if v == "EVEN"
                and n % 2 == 0
            then

                return
                    betAmount * 2
            end
        end

    --------------------------------------------------
    -- RANGE
    --------------------------------------------------

    elseif t == "range" then

        if v == "LOW"
            and n >= 1
            and n <= 18
        then

            return
                betAmount * 2
        end

        if v == "HIGH"
            and n >= 19
            and n <= 36
        then

            return
                betAmount * 2
        end

    --------------------------------------------------
    -- DOZEN
    --------------------------------------------------

    elseif t == "dozen" then

        local min =
            (v - 1)
            * 12
            + 1

        local max =
            v * 12

        if n >= min
            and n <= max
        then

            return
                betAmount * 3
        end
    end

    return 0
end

--------------------------------------------------
-- TOTAL PAYOUT
--------------------------------------------------

local function calculateTotalPayout(n)

    local payout = 0

    for _, bet in pairs(bets) do

        payout =
            payout
            + payoutForBet(
                bet,
                n
            )
    end

    return payout
end

--------------------------------------------------
-- SPIN
--------------------------------------------------

local function spin()

    if spinning then
        return
    end

    local count =
        betCount()

    if count <= 0 then

        message =
            "SELECT AT LEAST ONE BET"

        draw()

        return
    end

    local stake =
        totalStake()

    if credits < stake then

        message =
            "NOT ENOUGH CREDITS"

        draw()

        return
    end

    credits =
        credits - stake

    spinning = true

    resultNumber = nil
    winningIndex = nil

    message =
        "SPINNING..."

    --------------------------------------------------
    -- CHOOSE RESULT
    --------------------------------------------------

    local targetIndex =
        math.random(
            1,
            #wheel
        )

    local targetNumber =
        wheel[targetIndex]

    --------------------------------------------------
    -- FAST
    --------------------------------------------------

    for frame = 1, 45 do

        wheelIndex =
            wrapWheel(
                wheelIndex + 1
            )

        ballIndex =
            wrapRing(
                ballIndex - 1
            )

        draw()

        sleep(
            0.02
            + frame * 0.001
        )
    end

    --------------------------------------------------
    -- MEDIUM
    --------------------------------------------------

    for frame = 1, 25 do

        wheelIndex =
            wrapWheel(
                wheelIndex + 1
            )

        ballIndex =
            wrapRing(
                ballIndex - 1
            )

        draw()

        sleep(
            0.055
            + frame * 0.005
        )
    end

    --------------------------------------------------
    -- SLOW WHEEL
    --------------------------------------------------

    while wheelIndex ~= targetIndex do

        wheelIndex =
            wrapWheel(
                wheelIndex + 1
            )

        ballIndex =
            wrapRing(
                ballIndex - 1
            )

        draw()

        sleep(0.11)
    end

    --------------------------------------------------
    -- BALL BOUNCE
    --------------------------------------------------

    for i = 1, 12 do

        ballIndex =
            wrapRing(
                ballIndex + 1
            )

        draw()

        sleep(
            0.08
            + i * 0.025
        )
    end

    --------------------------------------------------
    -- FINAL RESULT
    --------------------------------------------------

    winningIndex =
        targetIndex

    resultNumber =
        targetNumber

    local payout =
        calculateTotalPayout(
            targetNumber
        )

    credits =
        credits + payout

    if payout > 0 then

        message =
            "WIN +"
            .. payout

    else

        message =
            "LOSE -"
            .. stake
    end

    spinning =
        false

    draw()
end

--------------------------------------------------
-- BET SIZE
--------------------------------------------------

local function lowerBet()

    if spinning then
        return
    end

    betAmount =
        math.max(
            5,
            betAmount - 5
        )

    draw()
end

local function raiseBet()

    if spinning then
        return
    end

    betAmount =
        math.min(
            100,
            betAmount + 5
        )

    draw()
end

--------------------------------------------------
-- TOUCH
--------------------------------------------------

local function handleTouch(x, y)

    if spinning then
        return
    end

    --------------------------------------------------
    -- NUMBER CELLS
    --------------------------------------------------

    for _, cell in ipairs(numberCells) do

        if x >= cell.x1
            and x <= cell.x2
            and y >= cell.y1
            and y <= cell.y2
        then

            toggleBet(
                {
                    type = "number",
                    value = cell.number
                }
            )

            message =
                betCount()
                .. " BETS SELECTED"

            draw()

            return
        end
    end

    --------------------------------------------------
    -- BUTTONS
    --------------------------------------------------

    for name, button in pairs(buttons) do

        if inside(
            button,
            x,
            y
        ) then

            if name == "spin" then

                spin()

            elseif name == "betDown" then

                lowerBet()

            elseif name == "betUp" then

                raiseBet()

            elseif name == "clear" then

                clearBets()
                draw()

            elseif button.data then

                toggleBet(
                    button.data
                )

                message =
                    betCount()
                    .. " BETS SELECTED"

                draw()
            end

            return
        end
    end
end

