--------------------------------------------------
-- MESSAGE
--------------------------------------------------

local function drawMessage()

    local color =
        colors.lightGray

    if message:find("WIN") then
        color =
            colors.green

    elseif message:find("LOSE")
        or message:find("NOT ENOUGH")
    then
        color =
            colors.red

    elseif message:find("SPINNING") then
        color =
            colors.yellow
    end

    centered(
        28,
        message,
        color
    )
end

--------------------------------------------------
-- FULL DRAW
--------------------------------------------------

local function draw()
    clear()

    drawHeader()
    drawWheel()
    drawNumberGrid()
    drawOutsideBets()
    drawMessage()
end

--------------------------------------------------
-- BET SELECTION
--------------------------------------------------

local function chooseBet(data, label)

    if spinning then
        return
    end

    selectedBet =
        data

    selectedLabel =
        label

    message =
        "READY"

    draw()
end

--------------------------------------------------
-- NUMBER BET
--------------------------------------------------

local function chooseNumber(n)

    chooseBet(
        {
            type = "number",
            value = n
        },
        "NUMBER " .. n
    )
end

--------------------------------------------------
-- PAYOUT
--------------------------------------------------

local function calculatePayout(n)

    if not selectedBet then
        return 0
    end

    local t =
        selectedBet.type

    local v =
        selectedBet.value

    --------------------------------------------------
    -- STRAIGHT
    --------------------------------------------------

    if t == "number" then

        if n == v then
            return betAmount * 36
        end

        return 0
    end

    --------------------------------------------------
    -- COLOR
    --------------------------------------------------

    if t == "color" then

        if numberColorName(n) == v then
            return betAmount * 2
        end

        return 0
    end

    --------------------------------------------------
    -- ODD / EVEN
    --------------------------------------------------

    if t == "parity" then

        if n == 0 then
            return 0
        end

        if v == "ODD"
            and n % 2 == 1
        then
            return betAmount * 2
        end

        if v == "EVEN"
            and n % 2 == 0
        then
            return betAmount * 2
        end

        return 0
    end

    --------------------------------------------------
    -- LOW / HIGH
    --------------------------------------------------

    if t == "range" then

        if v == "LOW"
            and n >= 1
            and n <= 18
        then
            return betAmount * 2
        end

        if v == "HIGH"
            and n >= 19
            and n <= 36
        then
            return betAmount * 2
        end

        return 0
    end

    --------------------------------------------------
    -- DOZENS
    --------------------------------------------------

    if t == "dozen" then

        local min =
            (v - 1) * 12 + 1

        local max =
            v * 12

        if n >= min
            and n <= max
        then
            return betAmount * 3
        end

        return 0
    end

    return 0
end

--------------------------------------------------
-- SPIN
--------------------------------------------------

local function spin()

    if spinning then
        return
    end

    if not selectedBet then

        message =
            "SELECT BET FIRST"

        draw()

        return
    end

    if credits < betAmount then

        message =
            "NOT ENOUGH CREDITS"

        draw()

        return
    end

    spinning = true

    credits =
        credits - betAmount

    resultNumber =
        nil

    message =
        "SPINNING..."

    --------------------------------------------------
    -- PICK RESULT
    --------------------------------------------------

    local finalWheelIndex =
        math.random(
            1,
            #wheel
        )

    local finalNumber =
        wheel[
            finalWheelIndex
        ]

    --------------------------------------------------
    -- FAST SPIN
    --------------------------------------------------

    local velocity =
        1

    for frame = 1, 45 do

        wheelIndex =
            wrapIndex(
                wheelIndex + 1
            )

        ballIndex =
            ballIndex - 1

        if ballIndex < 1 then
            ballIndex =
                #ringPositions
        end

        draw()

        sleep(
            0.025
            + frame * 0.002
        )
    end

    --------------------------------------------------
    -- MEDIUM SLOWDOWN
    --------------------------------------------------

    for frame = 1, 18 do

        wheelIndex =
            wrapIndex(
                wheelIndex + 1
            )

        ballIndex =
            ballIndex - 1

        if ballIndex < 1 then
            ballIndex =
                #ringPositions
        end

        draw()

        sleep(
            0.08
            + frame * 0.01
        )
    end

    --------------------------------------------------
    -- ALIGN WHEEL TO RESULT
    --------------------------------------------------

    while wheelIndex
        ~= finalWheelIndex
    do

        wheelIndex =
            wrapIndex(
                wheelIndex + 1
            )

        draw()

        sleep(0.15)
    end

    --------------------------------------------------
    -- BALL SETTLES
    --------------------------------------------------

    for i = 1, 8 do

        ballIndex =
            ballIndex + 1

        if ballIndex
            > #ringPositions
        then
            ballIndex = 1
        end

        draw()

        sleep(
            0.13
            + i * 0.035
        )
    end

    --------------------------------------------------
    -- RESULT
    --------------------------------------------------

    resultNumber =
        finalNumber

    local payout =
        calculatePayout(
            finalNumber
        )

    credits =
        credits + payout

    if payout > 0 then

        message =
            "WIN +"
            .. payout

    else

        message =
            "LOSE"
    end

    spinning =
        false

    draw()
end

--------------------------------------------------
-- BET AMOUNT
--------------------------------------------------

local function lowerBet()

    if spinning then
        return
    end

    betAmount =
        math.max(
            5,
            betAmount - 5
        )

    draw()
end

local function raiseBet()

    if spinning then
        return
    end

    betAmount =
        math.min(
            100,
            betAmount + 5
        )

    draw()
end

--------------------------------------------------
-- TOUCH
--------------------------------------------------

local function handleTouch(x, y)

    if spinning then
        return
    end

    --------------------------------------------------
    -- NUMBERS
    --------------------------------------------------

    for _, cell in ipairs(numberCells) do

        if x >= cell.x1
            and x <= cell.x2
            and y >= cell.y1
            and y <= cell.y2
        then

            chooseNumber(
                cell.number
            )

            return
        end
    end

    --------------------------------------------------
    -- OTHER BUTTONS
    --------------------------------------------------

    for name, button in pairs(buttons) do

        if inside(
            button,
            x,
            y
        ) then

            if name == "spin" then

                spin()

            elseif name == "betDown" then

                lowerBet()

            elseif name == "betUp" then

                raiseBet()

            elseif button.data then

                chooseBet(
                    button.data,
                    button.text
                )
            end

            return
        end
    end
end

