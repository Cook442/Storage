end

--------------------------------------------------
-- WHEEL DISPLAY
--------------------------------------------------

local wheelCenterX = 15
local wheelCenterY = 9

local ringPositions = {
    { 0,-4},
    { 3,-3},
    { 5,-1},
    { 5, 2},
    { 3, 4},
    { 0, 5},
    {-3, 4},
    {-5, 2},
    {-5,-1},
    {-3,-3}
}

local wheelIndex = 1
local ballIndex = 1

local function wrapIndex(i)
    while i < 1 do
        i = i + #wheel
    end

    while i > #wheel do
        i = i - #wheel
    end

    return i
end

local function drawWheel()

    --------------------------------------------------
    -- WOOD BACKPLATE
    --------------------------------------------------

    for y = 5, 14 do
        fill(
            6,
            y,
            19,
            colors.brown
        )
    end

    --------------------------------------------------
    -- INNER FELT
    --------------------------------------------------

    for y = 6, 13 do
        fill(
            7,
            y,
            17,
            colors.green
        )
    end

    --------------------------------------------------
    -- RING NUMBERS
    --------------------------------------------------

    for i, pos in ipairs(ringPositions) do
        local idx =
            wrapIndex(
                wheelIndex + i - 1
            )

        local n =
            wheel[idx]

        local x =
            wheelCenterX + pos[1]

        local y =
            wheelCenterY + pos[2]

        local txt =
            tostring(n)

        local bg =
            numberColor(n)

        writeAt(
            x,
            y,
            txt:sub(-1),
            colors.white,
            bg
        )
    end

    --------------------------------------------------
    -- CENTER
    --------------------------------------------------

    writeAt(
        wheelCenterX - 1,
        wheelCenterY,
        "O",
        colors.yellow,
        colors.black
    )

    --------------------------------------------------
    -- BALL
    --------------------------------------------------

    local ballPos =
        ringPositions[
            ((ballIndex - 1) % #ringPositions) + 1
        ]

    local bx =
        wheelCenterX + ballPos[1]

    local by =
        wheelCenterY + ballPos[2]

    writeAt(
        bx,
        by,
        "o",
        colors.white,
        colors.lightGray
    )

    --------------------------------------------------
    -- RESULT
    --------------------------------------------------

    if resultNumber ~= nil
        and not spinning
    then

        centered(
            15,
            "RESULT "
                .. resultNumber
                .. " "
                .. numberColorName(resultNumber),
            numberColor(resultNumber)
        )
    else
        centered(
            15,
            "SPINNING WHEEL",
            colors.gray
        )
    end
end

--------------------------------------------------
-- NUMBER GRID
--------------------------------------------------

local numberCells = {}

local function setupNumberGrid()

    numberCells = {}

    local startX = 1
    local startY = 17

    local cellW = 2

    --------------------------------------------------
    -- ZERO
    --------------------------------------------------

    table.insert(
        numberCells,
        {
            number = 0,
            x1 = 1,
            y1 = 17,
            x2 = 2,
            y2 = 22
        }
    )

    --------------------------------------------------
    -- 1-36
    --------------------------------------------------

    local n = 1

    for col = 1, 12 do
        for row = 1, 3 do

            local x =
                3
                + (col - 1) * cellW

            local y =
                17
                + (3 - row) * 2

            table.insert(
                numberCells,
                {
                    number = n,
                    x1 = x,
                    y1 = y,
                    x2 = x + 1,
                    y2 = y + 1
                }
            )

            n = n + 1
        end
    end
end

setupNumberGrid()

local function numberBetSelected(n)
    return
        selectedBet
        and selectedBet.type == "number"
        and selectedBet.value == n
end

local function drawNumberGrid()

    for _, cell in ipairs(numberCells) do

        local n =
            cell.number

        local bg =
            numberColor(n)

        if numberBetSelected(n) then
            bg =
                colors.yellow
        end

        for y = cell.y1, cell.y2 do
            fill(
                cell.x1,
                y,
                cell.x2 - cell.x1 + 1,
                bg
            )
        end

        local text =
            tostring(n)

        writeAt(
            cell.x1,
            cell.y1,
            text:sub(-1),
            numberBetSelected(n)
                and colors.black
                or colors.white,
            bg
        )
    end
end

