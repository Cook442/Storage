--------------------------------------------------
-- NUMBER BETTING GRID
--------------------------------------------------

local numberCells = {}

local function setupNumberCells()

    numberCells = {}

    local startY = 5

    for n = 0, 36 do

        local row =
            math.floor(n / 5)

        local col =
            n % 5

        local x =
            2 + col * 5

        local y =
            startY + row * 2

        table.insert(
            numberCells,
            {
                number = n,
                x1 = x,
                y1 = y,
                x2 = x + 3,
                y2 = y
            }
        )
    end
end

setupNumberCells()

local function numberSelected(n)
    return
        selectedBet
        and selectedBet.type == "number"
        and selectedBet.value == n
end

local function drawNumberGrid()

    for _, cell in ipairs(numberCells) do

        local n =
            cell.number

        local selected =
            numberSelected(n)

        local bg =
            selected
            and colors.yellow
            or numberColor(n)

        local fg =
            selected
            and colors.black
            or colors.white

        local text =
            tostring(n)

        local padding =
            " " .. text

        if #padding < 4 then
            padding =
                padding
                .. string.rep(
                    " ",
                    4 - #padding
                )
        end

        writeAt(
            cell.x1,
            cell.y1,
            padding,
            fg,
            bg
        )
    end
end

