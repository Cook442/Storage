--------------------------------------------------
-- DISTANCE
--------------------------------------------------

local function distance(
    x1,
    y1,
    x2,
    y2
)

    local dx =
        x2 - x1

    local dy =
        y2 - y1

    return math.sqrt(
        dx * dx
        + dy * dy
    )
end

--------------------------------------------------
-- POCKET DETECTION
--------------------------------------------------

local function checkPocket(ball)
    for _, pocket in ipairs(pockets) do

        local centerX =
            pocket.x + 0.5

        local centerY =
            pocket.y + 0.5

        if distance(
            ball.x,
            ball.y,
            centerX,
            centerY
        ) <= POCKET_RADIUS
        then

            ball.pocketed = true
            ball.vx = 0
            ball.vy = 0

            if ball.number == 0 then
                scratchThisTurn = true

            else
                table.insert(
                    pocketedThisTurn,
                    ball.number
                )
            end

            return true
        end
    end

    return false
end

--------------------------------------------------
-- BALL COLLISIONS
--------------------------------------------------

local function collideBalls(a, b)
    if a.pocketed
        or b.pocketed
    then
        return
    end

    local dx =
        b.x - a.x

    local dy =
        b.y - a.y

    local dist =
        math.sqrt(
            dx * dx
            + dy * dy
        )

    local minimum =
        BALL_RADIUS * 2

    if dist <= 0
        or dist >= minimum
    then
        return
    end

    local nx =
        dx / dist

    local ny =
        dy / dist

    local overlap =
        minimum - dist

    a.x =
        a.x
        - nx * overlap / 2

    a.y =
        a.y
        - ny * overlap / 2

    b.x =
        b.x
        + nx * overlap / 2

    b.y =
        b.y
        + ny * overlap / 2

    local relativeVX =
        b.vx - a.vx

    local relativeVY =
        b.vy - a.vy

    local normalVelocity =
        relativeVX * nx
        + relativeVY * ny

    if normalVelocity > 0 then
        return
    end

    local impulse =
        -normalVelocity * 0.98

    a.vx =
        a.vx
        - impulse * nx

    a.vy =
        a.vy
        - impulse * ny

    b.vx =
        b.vx
        + impulse * nx

    b.vy =
        b.vy
        + impulse * ny

    --------------------------------------------------
    -- CUE SPIN
    --------------------------------------------------

    local cue =
        getCueBall()

    if cue then
        local other = nil

        if a == cue then
            other = b

        elseif b == cue then
            other = a
        end

        if other then

            if cueSpinY > 0 then

                cue.vx =
                    cue.vx
                    + nx * 0.16

                cue.vy =
                    cue.vy
                    + ny * 0.16

            elseif cueSpinY < 0 then

                cue.vx =
                    cue.vx
                    - nx * 0.24

                cue.vy =
                    cue.vy
                    - ny * 0.24
            end
        end
    end
end

--------------------------------------------------
-- RAIL PHYSICS
--------------------------------------------------

local function bounceRails(ball)

    local isCue =
        ball.number == 0

    --------------------------------------------------
    -- LEFT
    --------------------------------------------------

    if ball.x < LEFT + BALL_RADIUS then

        ball.x =
            LEFT + BALL_RADIUS

        ball.vx =
            math.abs(ball.vx)
            * BOUNCE

        if isCue then
            ball.vy =
                ball.vy
                + cueSpinX * 0.12
        end

    --------------------------------------------------
    -- RIGHT
    --------------------------------------------------

    elseif ball.x > RIGHT - BALL_RADIUS then

        ball.x =
            RIGHT - BALL_RADIUS

        ball.vx =
            -math.abs(ball.vx)
            * BOUNCE

        if isCue then
            ball.vy =
                ball.vy
                - cueSpinX * 0.12
        end
    end

    --------------------------------------------------
    -- TOP
    --------------------------------------------------

    if ball.y < TOP + BALL_RADIUS then

        ball.y =
            TOP + BALL_RADIUS

        ball.vy =
            math.abs(ball.vy)
            * BOUNCE

        if isCue then
            ball.vx =
                ball.vx
                - cueSpinX * 0.12
        end

    --------------------------------------------------
    -- BOTTOM
    --------------------------------------------------

    elseif ball.y > BOTTOM - BALL_RADIUS then

        ball.y =
            BOTTOM - BALL_RADIUS

        ball.vy =
            -math.abs(ball.vy)
            * BOUNCE

        if isCue then
            ball.vx =
                ball.vx
                + cueSpinX * 0.12
        end
    end
end

--------------------------------------------------
-- PHYSICS
--------------------------------------------------

local function physicsStep()

    --------------------------------------------------
    -- MOVE BALLS
    --------------------------------------------------

    for _, ball in ipairs(balls) do

        if not ball.pocketed then

            ball.x =
                ball.x + ball.vx

            ball.y =
                ball.y + ball.vy

            if not checkPocket(ball) then
                bounceRails(ball)
            end
        end
    end

    --------------------------------------------------
    -- COLLISIONS
    --------------------------------------------------

    for i = 1, #balls - 1 do
        for j = i + 1, #balls do
            collideBalls(
                balls[i],
                balls[j]
            )
        end
    end

    --------------------------------------------------
    -- FRICTION
    --------------------------------------------------

    local anythingMoving =
        false

    for _, ball in ipairs(balls) do

        if not ball.pocketed then

            ball.vx =
                ball.vx
                * FRICTION

            ball.vy =
                ball.vy
                * FRICTION

            local velocity =
                math.sqrt(
                    ball.vx * ball.vx
                    + ball.vy * ball.vy
                )

            if velocity < STOP_SPEED then

                ball.vx = 0
                ball.vy = 0

            else
                anythingMoving =
                    true
            end
        end
    end

    return anythingMoving
end

--------------------------------------------------
-- GROUP REMAINING
--------------------------------------------------

local function groupRemaining(group)
    local remaining = 0

    for _, ball in ipairs(balls) do

        if not ball.pocketed
            and ballGroup(ball.number)
                == group
        then

            remaining =
                remaining + 1
        end
    end

    return remaining
end

--------------------------------------------------
-- RESET CUE
--------------------------------------------------

local function resetCue()
    local cue =
        getCueBall()

    cue.pocketed = false
    cue.vx = 0
    cue.vy = 0

    cue.x =
        LEFT
        + (RIGHT - LEFT) * 0.24

    cue.y =
        (TOP + BOTTOM) / 2
end

--------------------------------------------------
-- FINISH TURN
--------------------------------------------------

local function finishTurn()

    local keepTurn =
        false

    --------------------------------------------------
    -- 8 BALL
    --------------------------------------------------

    for _, number
        in ipairs(pocketedThisTurn)
    do

        if number == 8 then

            local group =
                playerGroups[
                    currentPlayer
                ]

            if group
                and groupRemaining(group) == 0
                and not scratchThisTurn
            then
                winner =
                    currentPlayer

            else
                winner =
                    currentPlayer == 1
                    and 2
                    or 1
            end

            gameOver = true

            return
        end
    end

    --------------------------------------------------
    -- ASSIGN GROUP
    --------------------------------------------------

    if not playerGroups[1] then

        for _, number
            in ipairs(pocketedThisTurn)
        do

            local group =
                ballGroup(number)

            if group then

                playerGroups[
                    currentPlayer
                ] = group

                local other =
                    currentPlayer == 1
                    and 2
                    or 1

                playerGroups[other] =
                    group == "SOLIDS"
                    and "STRIPES"
                    or "SOLIDS"

                break
            end
        end
    end

    --------------------------------------------------
    -- KEEP TURN?
    --------------------------------------------------

    if not scratchThisTurn then

        local group =
            playerGroups[
                currentPlayer
            ]

        if group then

            for _, number
                in ipairs(
                    pocketedThisTurn
                )
            do

                if ballGroup(number)
                    == group
                then

                    keepTurn =
                        true

                    break
                end
            end

        elseif #pocketedThisTurn > 0 then

            keepTurn =
                true
        end
    end

    --------------------------------------------------
    -- SCRATCH
    --------------------------------------------------

    if scratchThisTurn then
        resetCue()
        keepTurn = false
    end

    --------------------------------------------------
    -- SWITCH PLAYER
    --------------------------------------------------

    if not keepTurn then

        currentPlayer =
            currentPlayer == 1
            and 2
            or 1
    end

    pocketedThisTurn = {}
    scratchThisTurn = false

    aimX = nil
    aimY = nil

    cueSpinX = 0
    cueSpinY = 0

    spinIndex = 1
end

--------------------------------------------------
-- SHOOT
--------------------------------------------------

local function shoot()

    if moving
        or gameOver
        or not aimX
        or not aimY
    then
        return
    end

    local cue =
        getCueBall()

    if not cue
        or cue.pocketed
    then
        return
    end

    local dx =
        aimX - cue.x

    local dy =
        aimY - cue.y

    local length =
        math.sqrt(
            dx * dx
            + dy * dy
        )

    if length < 0.5 then
        return
    end

    dx =
        dx / length

    dy =
        dy / length

    --------------------------------------------------
    -- STRONGER POWER
    --------------------------------------------------

    local strength =
        0.26
        + (power / 100)
        * 1.04

    cue.vx =
        dx * strength

    cue.vy =
        dy * strength

    --------------------------------------------------
    -- SPIN
    --------------------------------------------------

    local spin =
        spinModes[spinIndex]

    cueSpinX =
        spin.x

    cueSpinY =
        spin.y

    pocketedThisTurn = {}
    scratchThisTurn = false

    moving = true
end

--------------------------------------------------
-- RESET GAME
--------------------------------------------------

local function resetGame()

    currentPlayer = 1

    playerGroups = {
        [1] = nil,
        [2] = nil
    }

    power = 55

    spinIndex = 1

    cueSpinX = 0
    cueSpinY = 0

    aimX = nil
    aimY = nil

    moving = false

    gameOver = false
    winner = nil

    pocketedThisTurn = {}
    scratchThisTurn = false

    setupBalls()

    draw()
end

--------------------------------------------------
-- TOUCH
--------------------------------------------------

local function handleTouch(x, y)

    if moving then
        return
    end

    --------------------------------------------------
    -- GAME OVER
    --------------------------------------------------

    if gameOver then

        if inside(
            buttons.shoot,
            x,
            y
        ) then
            resetGame()
        end

        return
    end

    --------------------------------------------------
    -- POWER DOWN
    --------------------------------------------------

    if inside(
        buttons.minus,
        x,
        y
    ) then

        power =
            math.max(
                10,
                power - 10
            )

        draw()

        return
    end

    --------------------------------------------------
    -- POWER UP
    --------------------------------------------------

    if inside(
        buttons.plus,
        x,
        y
    ) then

        power =
            math.min(
                100,
                power + 10
            )

        draw()

        return
    end

    --------------------------------------------------
    -- SPIN
    --------------------------------------------------

    if inside(
        buttons.spin,
        x,
        y
    ) then

        spinIndex =
            spinIndex + 1

        if spinIndex
            > #spinModes
        then
            spinIndex = 1
        end

        draw()

        return
    end

    --------------------------------------------------
    -- SHOOT
    --------------------------------------------------

    if inside(
        buttons.shoot,
        x,
        y
    ) then

        shoot()
        draw()

        return
    end

    --------------------------------------------------
    -- AIM
    --------------------------------------------------

    if x >= LEFT
        and x <= RIGHT
        and y >= TOP
        and y <= BOTTOM
    then

        aimX = x
        aimY = y

        draw()
    end
end

--------------------------------------------------
-- PHYSICS LOOP
--------------------------------------------------

local function physicsLoop()

    while true do

        if moving then

            local stillMoving =
                physicsStep()

            draw()

            if not stillMoving then

                moving = false

                finishTurn()

                draw()
            end

            sleep(0.045)

        else
            sleep(0.05)
        end
    end
end

--------------------------------------------------
-- TOUCH LOOP
--------------------------------------------------

local function touchLoop()

    while true do

        local _, side, x, y =
            os.pullEvent(
                "monitor_touch"
            )

        handleTouch(
            x,
            y
        )
    end
end

