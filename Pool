local monitor = peripheral.find("monitor")

if not monitor then
    error("No monitor found!")
end

monitor.setTextScale(0.5)

local W, H = monitor.getSize()

--------------------------------------------------
-- TABLE
--------------------------------------------------

local LEFT   = 4
local RIGHT  = W - 3
local TOP    = 5
local BOTTOM = H - 9

local BALL_RADIUS   = 0.52
local POCKET_RADIUS = 1.45

-- Slightly more energetic than V1
local FRICTION = 0.972
local STOP_SPEED = 0.028
local BOUNCE = 0.94

--------------------------------------------------
-- GAME STATE
--------------------------------------------------

local balls = {}

local currentPlayer = 1

local playerGroups = {
    [1] = nil,
    [2] = nil
}

local power = 55

local aimX = nil
local aimY = nil

local moving = false
local gameOver = false
local winner = nil

local pocketedThisTurn = {}
local scratchThisTurn = false

