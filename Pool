local monitor = peripheral.find("monitor")

if not monitor then
    error("No monitor found!")
end

monitor.setTextScale(0.5)

-- Dark billiard-table green
monitor.setPaletteColor(colors.green, 0x075E36)

local W, H = monitor.getSize()

--------------------------------------------------
-- TABLE
--------------------------------------------------

local LEFT   = 4
local RIGHT  = W - 3
local TOP    = 5
local BOTTOM = H - 9

local BALL_RADIUS   = 0.52
local POCKET_RADIUS = 1.65

local FRICTION  = 0.972
local STOP_SPEED = 0.028
local BOUNCE = 0.94

--------------------------------------------------
-- GAME STATE
--------------------------------------------------

local balls = {}

local currentPlayer = 1

local playerGroups = {
    [1] = nil,
    [2] = nil
}

local power = 55

local aimX = nil
local aimY = nil

local moving = false
local gameOver = false
local winner = nil

local pocketedThisTurn = {}
local scratchThisTurn = false

--------------------------------------------------
-- SPIN
--------------------------------------------------

local spinModes = {
    {name = "CENTER", symbol = "O", x = 0,  y = 0},
    {name = "TOP",    symbol = "^", x = 0,  y = 1},
    {name = "DRAW",   symbol = "v", x = 0,  y = -1},
    {name = "LEFT",   symbol = "<", x = -1, y = 0},
    {name = "RIGHT",  symbol = ">", x = 1,  y = 0}
}

local spinIndex = 1
local cueSpinX = 0
local cueSpinY = 0

--------------------------------------------------
-- BALL COLORS
--------------------------------------------------

local BALL_COLORS = {
    [1]  = colors.yellow,
    [2]  = colors.blue,
    [3]  = colors.red,
    [4]  = colors.purple,
    [5]  = colors.orange,

    -- brighter so they don't blend into felt
    [6]  = colors.lime,

    [7]  = colors.brown,
    [8]  = colors.black,

    [9]  = colors.yellow,
    [10] = colors.blue,
    [11] = colors.red,
    [12] = colors.purple,
    [13] = colors.orange,

    [14] = colors.lime,

    [15] = colors.brown
}

--------------------------------------------------
-- DRAW HELPERS
--------------------------------------------------

local function writeAt(x, y, text, fg, bg)
    x = math.floor(x)
    y = math.floor(y)

    if x < 1 or y < 1 or x > W or y > H then
        return
    end

    text = tostring(text)

    if #text > W - x + 1 then
        text = text:sub(1, W - x + 1)
    end

    monitor.setCursorPos(x, y)
    monitor.setTextColor(fg or colors.white)
    monitor.setBackgroundColor(bg or colors.black)
    monitor.write(text)
end

local function fill(x, y, width, color)
    x = math.floor(x)
    y = math.floor(y)
    width = math.floor(width)

    if width <= 0 then
        return
    end

    width = math.min(width, W - x + 1)

    monitor.setCursorPos(x, y)
    monitor.setBackgroundColor(color)
    monitor.write(string.rep(" ", width))
end

local function clear()
    monitor.setBackgroundColor(colors.black)
    monitor.clear()
end

local function centered(y, text, fg, bg)
    local x = math.floor((W - #text) / 2) + 1
    writeAt(x, y, text, fg, bg)
end

--------------------------------------------------
-- BUTTONS
--------------------------------------------------

local buttons = {}

local function addButton(name, x1, y1, x2, y2, text, color)
    buttons[name] = {
        x1 = x1,
        y1 = y1,
        x2 = x2,
        y2 = y2,
        text = text,
        color = color
    }
end

local function inside(button, x, y)
    return
        x >= button.x1
        and x <= button.x2
        and y >= button.y1
        and y <= button.y2
end

local function drawButton(button)
    for y = button.y1, button.y2 do
        fill(
            button.x1,
            y,
            button.x2 - button.x1 + 1,
            button.color
        )
    end

    local cx =
        math.floor(
            (
                button.x1
                + button.x2
                - #button.text
                + 1
            ) / 2
        )

    local cy =
        math.floor(
            (
                button.y1
                + button.y2
            ) / 2
        )

    writeAt(
        cx,
        cy,
        button.text,
        colors.white,
        button.color
    )
end

--------------------------------------------------
-- POCKETS
--------------------------------------------------

local pockets = {
    {x = LEFT, y = TOP},
    {x = (LEFT + RIGHT) / 2, y = TOP},
    {x = RIGHT - 1, y = TOP},

    {x = LEFT, y = BOTTOM - 1},
    {x = (LEFT + RIGHT) / 2, y = BOTTOM - 1},
    {x = RIGHT - 1, y = BOTTOM - 1}
}

--------------------------------------------------
-- BALL HELPERS
--------------------------------------------------

local function makeBall(number, x, y)
    return {
        number = number,
        x = x,
        y = y,
        vx = 0,
        vy = 0,
        pocketed = false
    }
end

local function getCueBall()
    for _, ball in ipairs(balls) do
        if ball.number == 0 then
            return ball
        end
    end
end

local function ballGroup(number)
    if number >= 1 and number <= 7 then
        return "SOLIDS"

    elseif number >= 9 and number <= 15 then
        return "STRIPES"
    end

    return nil
end

--------------------------------------------------
-- RACK
--------------------------------------------------

local function setupBalls()
    balls = {}

    local cueX =
        LEFT
        + (RIGHT - LEFT) * 0.24

    local cueY =
        (TOP + BOTTOM) / 2

    table.insert(
        balls,
        makeBall(
            0,
            cueX,
            cueY
        )
    )

    local rackX =
        LEFT
        + (RIGHT - LEFT) * 0.67

    local rackY =
        (TOP + BOTTOM) / 2

    local rack = {
        {1},
        {9, 2},
        {3, 8, 10},
        {11, 4, 12, 5},
        {6, 13, 7, 14, 15}
    }

    local spacingX = 1.20
    local spacingY = 1.10

    for column, columnBalls in ipairs(rack) do
        local x =
            rackX
            + (column - 1) * spacingX

        local total =
            #columnBalls

        local startY =
            rackY
            - ((total - 1) * spacingY / 2)

        for row, number in ipairs(columnBalls) do
            local y =
                startY
                + (row - 1) * spacingY

            table.insert(
                balls,
                makeBall(
                    number,
                    x,
                    y
                )
            )
        end
    end
end

--------------------------------------------------
-- TABLE
--------------------------------------------------

local function drawTable()

    --------------------------------------------------
    -- FELT
    --------------------------------------------------

    for y = TOP, BOTTOM do
        fill(
            LEFT,
            y,
            RIGHT - LEFT + 1,
            colors.green
        )
    end

    --------------------------------------------------
    -- WOOD RAILS
    --------------------------------------------------

    for x = LEFT - 2, RIGHT + 2 do
        writeAt(
            x,
            TOP - 2,
            " ",
            colors.white,
            colors.brown
        )

        writeAt(
            x,
            TOP - 1,
            " ",
            colors.white,
            colors.brown
        )

        writeAt(
            x,
            BOTTOM + 1,
            " ",
            colors.white,
            colors.brown
        )

        writeAt(
            x,
            BOTTOM + 2,
            " ",
            colors.white,
            colors.brown
        )
    end

    for y = TOP - 2, BOTTOM + 2 do
        fill(
            LEFT - 2,
            y,
            2,
            colors.brown
        )

        fill(
            RIGHT + 1,
            y,
            2,
            colors.brown
        )
    end

    --------------------------------------------------
    -- INNER CUSHIONS
    --------------------------------------------------

    for x = LEFT, RIGHT do
        writeAt(
            x,
            TOP,
            " ",
            colors.white,
            colors.lime
        )

        writeAt(
            x,
            BOTTOM,
            " ",
            colors.white,
            colors.lime
        )
    end

    --------------------------------------------------
    -- 2x2 POCKETS
    --------------------------------------------------

    for _, pocket in ipairs(pockets) do
        local px =
            math.floor(pocket.x)

        local py =
            math.floor(pocket.y)

        fill(
            px,
            py,
            2,
            colors.black
        )

        fill(
            px,
            py + 1,
            2,
            colors.black
        )
    end
end

--------------------------------------------------
-- BALL DRAWING
--------------------------------------------------

local function drawBall(ball)
    if ball.pocketed then
        return
    end

    local x =
        math.floor(
            ball.x + 0.5
        )

    local y =
        math.floor(
            ball.y + 0.5
        )

    --------------------------------------------------
    -- CUE BALL
    --------------------------------------------------

    if ball.number == 0 then
        writeAt(
            x,
            y,
            "O",
            colors.lightGray,
            colors.white
        )

        return
    end

    --------------------------------------------------
    -- 8 BALL
    --------------------------------------------------

    if ball.number == 8 then
        writeAt(
            x,
            y,
            "8",
            colors.white,
            colors.black
        )

        return
    end

    local ballColor =
        BALL_COLORS[ball.number]

    --------------------------------------------------
    -- SOLIDS
    --------------------------------------------------

    if ball.number <= 7 then
        writeAt(
            x,
            y,
            tostring(ball.number),
            colors.white,
            ballColor
        )

    --------------------------------------------------
    -- STRIPES
    --------------------------------------------------

    else
        local digit =
            tostring(ball.number):sub(-1)

        writeAt(
            x,
            y,
            digit,
            ballColor,
            colors.white
        )
    end
end

--------------------------------------------------
-- GAMEPIGEON-STYLE SHOT PREDICTION
--------------------------------------------------

local function drawAimLine()
    if moving
        or gameOver
        or not aimX
        or not aimY
    then
        return
    end

    local cue =
        getCueBall()

    if not cue
        or cue.pocketed
    then
        return
    end

    --------------------------------------------------
    -- AIM DIRECTION
    --------------------------------------------------

    local dx =
        aimX - cue.x

    local dy =
        aimY - cue.y

    local length =
        math.sqrt(
            dx * dx
            + dy * dy
        )

    if length < 0.1 then
        return
    end

    dx = dx / length
    dy = dy / length

    --------------------------------------------------
    -- FIND FIRST BALL HIT
    --------------------------------------------------

    local hitBall = nil
    local hitDistance = nil
    local hitX = nil
    local hitY = nil

    for _, ball in ipairs(balls) do
        if ball.number ~= 0
            and not ball.pocketed
        then

            local bx =
                ball.x - cue.x

            local by =
                ball.y - cue.y

            local projection =
                bx * dx
                + by * dy

            if projection > 0 then

                local closestX =
                    cue.x
                    + dx * projection

                local closestY =
                    cue.y
                    + dy * projection

                local distanceToLine =
                    math.sqrt(
                        (ball.x - closestX)
                        * (ball.x - closestX)
                        +
                        (ball.y - closestY)
                        * (ball.y - closestY)
                    )

                local collisionRadius =
                    BALL_RADIUS * 2

                if distanceToLine <= collisionRadius then

                    local offset =
                        math.sqrt(
                            math.max(
                                0,
                                collisionRadius
                                * collisionRadius
                                -
                                distanceToLine
                                * distanceToLine
                            )
                        )

                    local collisionDistance =
                        projection - offset

                    if collisionDistance > 0
                        and (
                            not hitDistance
                            or collisionDistance < hitDistance
                        )
                    then
                        hitDistance =
                            collisionDistance

                        hitBall =
                            ball

                        hitX =
                            cue.x
                            + dx * collisionDistance

                        hitY =
                            cue.y
                            + dy * collisionDistance
                    end
                end
            end
        end
    end

    --------------------------------------------------
    -- DRAW CUE AIM LINE
    --------------------------------------------------

    local maxAimDistance = 25

    if hitDistance then
        maxAimDistance =
            hitDistance
    end

    local step = 0.65
    local distanceAlong = 1.5

    while distanceAlong < maxAimDistance do

        local px =
            cue.x
            + dx * distanceAlong

        local py =
            cue.y
            + dy * distanceAlong

        if px > LEFT
            and px < RIGHT
            and py > TOP
            and py < BOTTOM
        then

            writeAt(
                math.floor(px + 0.5),
                math.floor(py + 0.5),
                ".",
                colors.white,
                colors.green
            )

        else
            break
        end

        distanceAlong =
            distanceAlong + step
    end

    --------------------------------------------------
    -- HIT PREDICTION
    --------------------------------------------------

    if hitBall then

        --------------------------------------------------
        -- CONTACT POINT
        --------------------------------------------------

        writeAt(
            math.floor(hitX + 0.5),
            math.floor(hitY + 0.5),
            "+",
            colors.yellow,
            colors.green
        )

        --------------------------------------------------
        -- OBJECT BALL DIRECTION
        --------------------------------------------------

        local objectDX =
            hitBall.x - hitX

        local objectDY =
            hitBall.y - hitY

        local objectLength =
            math.sqrt(
                objectDX * objectDX
                + objectDY * objectDY
            )

        if objectLength > 0 then

            objectDX =
                objectDX / objectLength

            objectDY =
                objectDY / objectLength

            for i = 1, 9 do

                local px =
                    hitBall.x
                    + objectDX * i

                local py =
                    hitBall.y
                    + objectDY * i

                if px > LEFT
                    and px < RIGHT
                    and py > TOP
                    and py < BOTTOM
                then

                    writeAt(
                        math.floor(px + 0.5),
                        math.floor(py + 0.5),
                        ":",
                        colors.yellow,
                        colors.green
                    )
                else
                    break
                end
            end
        end

        --------------------------------------------------
        -- APPROXIMATE CUE-BALL DEFLECTION
        --------------------------------------------------

        local normalX =
            hitBall.x - hitX

        local normalY =
            hitBall.y - hitY

        local normalLength =
            math.sqrt(
                normalX * normalX
                + normalY * normalY
            )

        if normalLength > 0 then

            normalX =
                normalX / normalLength

            normalY =
                normalY / normalLength

            local dot =
                dx * normalX
                + dy * normalY

            local deflectX =
                dx - dot * normalX

            local deflectY =
                dy - dot * normalY

            local deflectLength =
                math.sqrt(
                    deflectX * deflectX
                    + deflectY * deflectY
                )

            if deflectLength > 0.05 then

                deflectX =
                    deflectX / deflectLength

                deflectY =
                    deflectY / deflectLength

                for i = 1, 5 do

                    local px =
                        hitX
                        + deflectX * i

                    local py =
                        hitY
                        + deflectY * i

                    if px > LEFT
                        and px < RIGHT
                        and py > TOP
                        and py < BOTTOM
                    then

                        writeAt(
                            math.floor(px + 0.5),
                            math.floor(py + 0.5),
                            "'",
                            colors.lightGray,
                            colors.green
                        )
                    end
                end
            end
        end

    --------------------------------------------------
    -- NO BALL HIT
    --------------------------------------------------

    else
        writeAt(
            math.floor(aimX + 0.5),
            math.floor(aimY + 0.5),
            "+",
            colors.yellow,
            colors.green
        )
    end
end

