    {
        name = "CENTER",
        symbol = "O",
        x = 0,
        y = 0
    },

    {
        name = "TOP",
        symbol = "^",
        x = 0,
        y = 1
    },

    {
        name = "DRAW",
        symbol = "v",
        x = 0,
        y = -1
    },

    {
        name = "LEFT",
        symbol = "<",
        x = -1,
        y = 0
    },

    {
        name = "RIGHT",
        symbol = ">",
        x = 1,
        y = 0
    }
}

