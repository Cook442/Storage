--------------------------------------------------
-- MESSAGE
--------------------------------------------------

local function drawMessage()
    local color =
        colors.white

    if message:find("JACKPOT") then
        color =
            colors.yellow

    elseif message:find("WIN") then
        color =
            colors.green

    elseif message:find("ENOUGH") then
        color =
            colors.red
    end

    centered(
        31,
        message,
        color
    )
end

--------------------------------------------------
-- FULL DRAW
--------------------------------------------------

local function draw()
    clear()

    drawHeader()
    drawFrame()

    drawSymbol(
        1,
        reels[1]
    )

    drawSymbol(
        2,
        reels[2]
    )

    drawSymbol(
        3,
        reels[3]
    )

    drawPayline()
    drawPayTable()
    drawMessage()

    drawButton(
        buttons.betDown
    )

    drawButton(
        buttons.spin
    )

    drawButton(
        buttons.betUp
    )
end

--------------------------------------------------
-- RANDOM SYMBOL
--------------------------------------------------

local function randomSymbol()
    return math.random(
        1,
        #symbols
    )
end

--------------------------------------------------
-- PAYOUT
--------------------------------------------------

local function calculatePayout()
    local a =
        reels[1]

    local b =
        reels[2]

    local c =
        reels[3]

    --------------------------------------------------
    -- THREE 7s
    --------------------------------------------------

    if a == 1
        and b == 1
        and c == 1
    then

        local amount =
            bet * 50

        return amount,
            "JACKPOT! +" .. amount
    end

    --------------------------------------------------
    -- THREE MATCHING
    --------------------------------------------------

    if a == b
        and b == c
    then

        local multiplier =
            symbols[a].payout
            or 10

        local amount =
            bet * multiplier

        return amount,
            "BIG WIN! +" .. amount
    end

    --------------------------------------------------
    -- TWO MATCHING
    --------------------------------------------------

    if a == b
        or a == c
        or b == c
    then

        local amount =
            bet * 2

        return amount,
            "WIN! +" .. amount
    end

    return 0,
        "NO WIN"
end

--------------------------------------------------
-- SPIN
--------------------------------------------------

local function spin()
    if spinning then
        return
    end

    if credits < bet then
        message =
            "NOT ENOUGH CREDITS"

        draw()
        return
    end

    spinning = true

    credits =
        credits - bet

    message =
        "SPINNING..."

    --------------------------------------------------
    -- REEL ANIMATION
    --------------------------------------------------

    for frame = 1, 20 do

        if frame <= 11 then
            reels[1] =
                randomSymbol()
        end

        if frame <= 15 then
            reels[2] =
                randomSymbol()
        end

        reels[3] =
            randomSymbol()

        draw()

        sleep(
            0.035
            + frame * 0.006
        )
    end

    --------------------------------------------------
    -- FINAL RESULTS
    --------------------------------------------------

    reels[1] =
        randomSymbol()

    reels[2] =
        randomSymbol()

    reels[3] =
        randomSymbol()

    local payout,
        payoutMessage =
        calculatePayout()

    credits =
        credits + payout

    message =
        payoutMessage

    spinning =
        false

    draw()
end

--------------------------------------------------
-- BET DOWN
--------------------------------------------------

local function lowerBet()
    if spinning then
        return
    end

    if bet > 10 then
        bet =
            bet - 5
    end

    draw()
end

--------------------------------------------------
-- BET UP
--------------------------------------------------

local function raiseBet()
    if spinning then
        return
    end

    if bet < 100 then
        bet =
            bet + 5
    end

    draw()
end

--------------------------------------------------
-- TOUCH
--------------------------------------------------

local function handleTouch(x, y)
    if inside(
        buttons.spin,
        x,
        y
    ) then

        spin()
        return
    end

    if inside(
        buttons.betDown,
        x,
        y
    ) then

        lowerBet()
        return
    end

    if inside(
        buttons.betUp,
        x,
        y
    ) then

        raiseBet()
        return
    end
end

