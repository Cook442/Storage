--------------------------------------------------
-- CABINET
--------------------------------------------------

local function drawFrame()
    local x1 = 4
    local x2 = W - 3

    local y1 = 7
    local y2 = 26

    --------------------------------------------------
    -- OUTER CABINET
    --------------------------------------------------

    for y = y1, y2 do
        fill(
            x1,
            y,
            x2 - x1 + 1,
            colors.orange
        )
    end

    --------------------------------------------------
    -- INNER BLACK PANEL
    --------------------------------------------------

    for y = y1 + 2, y2 - 2 do
        fill(
            x1 + 2,
            y,
            x2 - x1 - 3,
            colors.black
        )
    end

    centered(
        y1,
        "* * * JACKPOT * * *",
        colors.yellow,
        colors.orange
    )
end

--------------------------------------------------
-- PIXEL SPRITE
--------------------------------------------------

local function drawPixelSprite(x, y, sprite)
    for row = 1, #sprite do
        local line = sprite[row]

        for col = 1, #line do
            local pixel =
                line:sub(col, col)

            if pixel ~= " " then
                local color =
                    PIXEL_COLORS[pixel]

                if color then
                    writeAt(
                        x + col - 1,
                        y + row - 1,
                        " ",
                        colors.white,
                        color
                    )
                else
                    -- allows letters like BAR
                    writeAt(
                        x + col - 1,
                        y + row - 1,
                        pixel,
                        colors.white,
                        colors.black
                    )
                end
            end
        end
    end
end

--------------------------------------------------
-- REEL SYMBOL
--------------------------------------------------

local function drawSymbol(reelNumber, symbolIndex)
    local symbol =
        symbols[symbolIndex]

    local reelWidth = 13
    local spacing = 2

    local totalWidth =
        reelWidth * 3
        + spacing * 2

    local startX =
        math.floor(
            (W - totalWidth) / 2
        ) + 1

    local x =
        startX
        + (reelNumber - 1)
        * (reelWidth + spacing)

    local y = 11

    --------------------------------------------------
    -- WHITE REEL FRAME
    --------------------------------------------------

    for row = y, y + 9 do
        fill(
            x,
            row,
            reelWidth,
            colors.white
        )
    end

    --------------------------------------------------
    -- INNER REEL
    --------------------------------------------------

    for row = y + 1, y + 6 do
        fill(
            x + 1,
            row,
            reelWidth - 2,
            colors.lightGray
        )
    end

    --------------------------------------------------
    -- SPRITE
    --------------------------------------------------

    drawPixelSprite(
        x + 3,
        y + 1,
        symbol.sprite
    )

    --------------------------------------------------
    -- LABEL
    --------------------------------------------------

    local label =
        symbol.name

    if #label > reelWidth - 2 then
        label =
            label:sub(
                1,
                reelWidth - 2
            )
    end

    local labelX =
        x
        + math.floor(
            (reelWidth - #label) / 2
        )

    writeAt(
        labelX,
        y + 8,
        label,
        colors.black,
        colors.white
    )
end

