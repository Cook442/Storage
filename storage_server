-- ============================================================
-- COOK'S STORAGE - UNIVERSAL STORAGE NODE
-- Install this SAME file on every storage computer.
-- ============================================================

local DISPLAY_ID = 1
local PROTOCOL = "cooks_storage_v2"
local REFRESH_SECONDS = 5

--------------------------------------------------
-- FIND WIRELESS MODEM AUTOMATICALLY
--------------------------------------------------

local wirelessModem = nil

for _, name in ipairs(peripheral.getNames()) do
    if peripheral.hasType(name, "modem") then
        local modem = peripheral.wrap(name)

        if modem and modem.isWireless and modem.isWireless() then
            wirelessModem = name
            break
        end
    end
end

if not wirelessModem then
    error("No wireless modem found!")
end

if not rednet.isOpen(wirelessModem) then
    rednet.open(wirelessModem)
end

--------------------------------------------------
-- NODE INFO
--------------------------------------------------

local COMPUTER_ID = os.getComputerID()
local NODE_NAME = os.getComputerLabel()

if not NODE_NAME or NODE_NAME == "" then
    NODE_NAME = "Storage #" .. COMPUTER_ID
end

--------------------------------------------------
-- CATEGORY DETECTION
--------------------------------------------------

local function categoryFor(name)
    local namespace, id = name:match("^([^:]+):(.+)$")

    namespace = namespace or "minecraft"
    id = id or name

    if namespace == "create"
        or namespace:find("^create")
        or namespace:find("railway")
        or namespace:find("locometal")
    then
        return "Create"
    end

    if id:find("log")
        or id:find("wood")
        or id:find("planks")
        or id:find("sapling")
        or id:find("leaves")
        or id:find("bamboo")
        or id:find("stem")
        or id:find("hyphae")
    then
        return "Wood"
    end

    if id:find("ore")
        or id:find("ingot")
        or id:find("nugget")
        or id:find("diamond")
        or id:find("emerald")
        or id:find("coal")
        or id:find("quartz")
        or id:find("raw_")
        or id:find("gem")
        or id:find("crystal")
    then
        return "Ores/Gems"
    end

    if id:find("apple")
        or id:find("bread")
        or id:find("beef")
        or id:find("pork")
        or id:find("chicken")
        or id:find("mutton")
        or id:find("fish")
        or id:find("salmon")
        or id:find("cod")
        or id:find("potato")
        or id:find("carrot")
        or id:find("berry")
        or id:find("tomato")
        or id:find("cabbage")
        or id:find("onion")
        or id:find("food")
        or id:find("stew")
        or id:find("soup")
        or id:find("cookie")
        or id:find("cake")
    then
        return "Food"
    end

    if id:find("helmet")
        or id:find("chestplate")
        or id:find("leggings")
        or id:find("boots")
    then
        return "Armor"
    end

    if id:find("pickaxe")
        or id:find("shovel")
        or id:find("hoe")
        or id:find("shears")
        or id:find("wrench")
        or id:find("axe")
    then
        return "Tools"
    end

    if id:find("sword")
        or id:find("bow")
        or id:find("crossbow")
        or id:find("trident")
        or id:find("gun")
    then
        return "Weapons"
    end

    if id:find("potion")
        or id:find("elixir")
    then
        return "Potions"
    end

    if id:find("stone")
        or id:find("dirt")
        or id:find("sand")
        or id:find("gravel")
        or id:find("brick")
        or id:find("glass")
        or id:find("deepslate")
        or id:find("tuff")
        or id:find("cobble")
        or id:find("concrete")
        or id:find("terracotta")
    then
        return "Blocks"
    end

    return "Misc"
end

--------------------------------------------------
-- STORAGE SCAN
--------------------------------------------------

local previousItems = nil
local previousSlots = nil
local previousTime = os.epoch("utc")

local function scanStorage()

    local data = {
        nodeId = COMPUTER_ID,
        nodeName = NODE_NAME,

        inventories = 0,

        totalSlots = 0,
        usedSlots = 0,

        totalItems = 0,
        itemTypes = 0,

        itemsPerMinute = 0,
        slotsPerMinute = 0,

        categories = {
            ["Wood"] = 0,
            ["Ores/Gems"] = 0,
            ["Tools"] = 0,
            ["Misc"] = 0,
            ["Armor"] = 0,
            ["Potions"] = 0,
            ["Blocks"] = 0,
            ["Create"] = 0,
            ["Food"] = 0,
            ["Weapons"] = 0
        },

        topItems = {}
    }

    local itemTotals = {}

    --------------------------------------------------
    -- FIND EVERY LOCAL INVENTORY
    --------------------------------------------------

    for _, name in ipairs(peripheral.getNames()) do

        if peripheral.hasType(name, "inventory") then

            local inv = peripheral.wrap(name)

            if inv then

                local okList, contents = pcall(inv.list)
                local okSize, size = pcall(inv.size)

                if okList and okSize and contents and size then

                    data.inventories =
                        data.inventories + 1

                    data.totalSlots =
                        data.totalSlots + size

                    for _, item in pairs(contents) do

                        data.usedSlots =
                            data.usedSlots + 1

                        data.totalItems =
                            data.totalItems + item.count

                        if not itemTotals[item.name] then
                            itemTotals[item.name] = 0
                            data.itemTypes =
                                data.itemTypes + 1
                        end

                        itemTotals[item.name] =
                            itemTotals[item.name] + item.count

                        local category =
                            categoryFor(item.name)

                        data.categories[category] =
                            data.categories[category]
                            + item.count
                    end
                end
            end
        end
    end

    --------------------------------------------------
    -- TOP ITEMS
    --------------------------------------------------

    local sorted = {}

    for name, count in pairs(itemTotals) do
        table.insert(sorted, {
            name = name,
            count = count
        })
    end

    table.sort(sorted, function(a, b)
        return a.count > b.count
    end)

    for i = 1, math.min(50, #sorted) do
        data.topItems[i] = sorted[i]
    end

    --------------------------------------------------
    -- RATES
    --------------------------------------------------

    local now = os.epoch("utc")

    if previousItems ~= nil then

        local minutes =
            (now - previousTime) / 60000

        if minutes > 0 then

            data.itemsPerMinute =
                math.floor(
                    (data.totalItems - previousItems)
                    / minutes
                )

            data.slotsPerMinute =
                math.floor(
                    (data.usedSlots - previousSlots)
                    / minutes
                )
        end
    end

    previousItems = data.totalItems
    previousSlots = data.usedSlots
    previousTime = now

    return data
end

--------------------------------------------------
-- SCREEN
--------------------------------------------------

term.clear()
term.setCursorPos(1, 1)

print("COOK'S STORAGE NODE")
print("--------------------")
print("Name: " .. NODE_NAME)
print("Computer #" .. COMPUTER_ID)
print("Wireless: " .. wirelessModem)
print("Display: #1")
print("")

--------------------------------------------------
-- MAIN LOOP
--------------------------------------------------

while true do

    local data = scanStorage()

    local sent =
        rednet.send(
            DISPLAY_ID,
            data,
            PROTOCOL
        )

    term.setCursorPos(1, 8)

    term.clearLine()
    print("Inventories: " .. data.inventories)

    term.clearLine()
    print("Items: " .. data.totalItems)

    term.clearLine()
    print(
        "Slots: "
        .. data.usedSlots
        .. "/"
        .. data.totalSlots
    )

    term.clearLine()

    if sent then
        print("COOK'S STORAGE: ONLINE ")
    else
        print("COOK'S STORAGE: OFFLINE")
    end

    sleep(REFRESH_SECONDS)
end
