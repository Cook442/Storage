local monitor = peripheral.find("monitor")

if not monitor then
    error("No monitor found!")
end

monitor.setTextScale(0.5)

local W, H = monitor.getSize()

-- Designed for 57x38, but still adapts if slightly different.
local HEADER_Y = 1
local BORDER_TOP = 3
local GAME_BOTTOM = H - 9

local MIN_X = 2
local MAX_X = W - 1
local MIN_Y = BORDER_TOP + 1
local MAX_Y = GAME_BOTTOM - 1

local START_SPEED = 0.20
local MIN_SPEED = 0.06

local snake = {}
local food = {}

local direction = {x = 1, y = 0}
local nextDirection = {x = 1, y = 0}

local score = 0
local highScore = 0
local speed = START_SPEED

local started = false
local gameOver = false
local running = true

local buttons = {}

--------------------------------------------------
-- BASIC DRAWING
--------------------------------------------------

local function writeAt(x, y, text, fg, bg)
    if x < 1 or y < 1 or x > W or y > H then
        return
    end

    text = tostring(text)

    if #text > W - x + 1 then
        text = text:sub(1, W - x + 1)
    end

    monitor.setCursorPos(x, y)
    monitor.setTextColor(fg or colors.white)
    monitor.setBackgroundColor(bg or colors.black)
    monitor.write(text)
end

local function fill(x, y, width, color)
    if width <= 0 then
        return
    end

    width = math.min(width, W - x + 1)

    monitor.setCursorPos(x, y)
    monitor.setBackgroundColor(color)
    monitor.write(string.rep(" ", width))
    monitor.setBackgroundColor(colors.black)
end

local function clear()
    monitor.setBackgroundColor(colors.black)
    monitor.clear()
end

local function centered(y, text, fg, bg)
    local x = math.floor((W - #text) / 2) + 1
    writeAt(x, y, text, fg, bg)
end

--------------------------------------------------
-- BUTTON SYSTEM
--------------------------------------------------

local function addButton(name, x1, y1, x2, y2, text, color)
    buttons[name] = {
        x1 = x1,
        y1 = y1,
        x2 = x2,
        y2 = y2,
        text = text,
        color = color
    }
end

local function drawButton(button)
    for y = button.y1, button.y2 do
        fill(
            button.x1,
            y,
            button.x2 - button.x1 + 1,
            button.color
        )
    end

    local cx =
        math.floor(
            (button.x1 + button.x2 - #button.text + 1) / 2
        )

    local cy =
        math.floor(
            (button.y1 + button.y2) / 2
        )

    writeAt(
        cx,
        cy,
        button.text,
        colors.white,
        button.color
    )
end

local function inside(button, x, y)
    return
        x >= button.x1
        and x <= button.x2
        and y >= button.y1
        and y <= button.y2
end

--------------------------------------------------
-- FIXED 57x38 CONTROL LAYOUT
--------------------------------------------------

local centerX = math.floor(W / 2)

local UP_Y1 = H - 7
local UP_Y2 = H - 5

local LOWER_Y1 = H - 4
local LOWER_Y2 = H - 2

addButton(
    "up",
    centerX - 3,
    UP_Y1,
    centerX + 3,
    UP_Y2,
    "^",
    colors.blue
)

addButton(
    "left",
    centerX - 12,
    LOWER_Y1,
    centerX - 6,
    LOWER_Y2,
    "<",
    colors.blue
)

addButton(
    "down",
    centerX - 3,
    LOWER_Y1,
    centerX + 3,
    LOWER_Y2,
    "v",
    colors.blue
)

addButton(
    "right",
    centerX + 6,
    LOWER_Y1,
    centerX + 12,
    LOWER_Y2,
    ">",
    colors.blue
)

--------------------------------------------------
-- GAME BORDER
--------------------------------------------------

local function drawBorder()
    for x = 1, W do
        writeAt(
            x,
            BORDER_TOP,
            " ",
            colors.white,
            colors.gray
        )

        writeAt(
            x,
            GAME_BOTTOM,
            " ",
            colors.white,
            colors.gray
        )
    end

    for y = BORDER_TOP, GAME_BOTTOM do
        writeAt(
            1,
            y,
            " ",
            colors.white,
            colors.gray
        )

        writeAt(
            W,
            y,
            " ",
            colors.white,
            colors.gray
        )
    end
end

--------------------------------------------------
-- HEADER
--------------------------------------------------

local function drawHeader()
    writeAt(
        2,
        HEADER_Y,
        "COOK'S SNAKE",
        colors.lime
    )

    local scoreText =
        "SCORE " .. score

    local bestText =
        "BEST " .. highScore

    writeAt(
        math.floor(W / 2) - math.floor(#scoreText / 2),
        HEADER_Y,
        scoreText,
        colors.white
    )

    writeAt(
        W - #bestText - 1,
        HEADER_Y,
        bestText,
        colors.yellow
    )
end

--------------------------------------------------
-- SNAKE + FOOD
--------------------------------------------------

local function snakeContains(x, y)
    for _, part in ipairs(snake) do
        if part.x == x and part.y == y then
            return true
        end
    end

    return false
end

local function spawnFood()
    repeat
        food = {
            x = math.random(MIN_X, MAX_X),
            y = math.random(MIN_Y, MAX_Y)
        }
    until not snakeContains(food.x, food.y)
end

local function drawSnake()
    for i, part in ipairs(snake) do
        local color

        if i == 1 then
            color = colors.lime
        else
            color = colors.green
        end

        writeAt(
            part.x,
            part.y,
            " ",
            colors.white,
            color
        )
    end
end

local function drawFood()
    writeAt(
        food.x,
        food.y,
        " ",
        colors.white,
        colors.red
    )
end

--------------------------------------------------
-- CONTROLS
--------------------------------------------------

local function drawControls()
    drawButton(buttons.up)
    drawButton(buttons.left)
    drawButton(buttons.down)
    drawButton(buttons.right)

    centered(
        H,
        "TOUCH CONTROLS",
        colors.gray
    )
end

--------------------------------------------------
-- GAME DRAW
--------------------------------------------------

local function drawGame()
    clear()
    drawHeader()
    drawBorder()
    drawFood()
    drawSnake()
    drawControls()
end

