local monitor = peripheral.find("monitor")

if not monitor then
    error("No Advanced Monitor found!")
end

monitor.setTextScale(0.5)
monitor.setBackgroundColor(colors.black)
monitor.setTextColor(colors.white)
monitor.clear()

local W, H = monitor.getSize()

-- Game settings
local START_SPEED = 0.22
local MIN_SPEED = 0.07

-- Reserve bottom area for controls
local CONTROL_HEIGHT = 6

local MIN_X = 2
local MAX_X = W - 1
local MIN_Y = 4
local MAX_Y = H - CONTROL_HEIGHT - 1

local snake = {}
local food = {}

local direction = {x = 1, y = 0}
local nextDirection = {x = 1, y = 0}

local score = 0
local highScore = 0

local speed = START_SPEED

local gameOver = false
local started = false
local running = true

--------------------------------------------------
-- HELPERS
--------------------------------------------------

local function writeAt(x, y, text, fg, bg)
    if x < 1 or y < 1 or x > W or y > H then
        return
    end

    text = tostring(text)

    if #text > W - x + 1 then
        text = text:sub(1, W - x + 1)
    end

    monitor.setCursorPos(x, y)
    monitor.setTextColor(fg or colors.white)
    monitor.setBackgroundColor(bg or colors.black)
    monitor.write(text)
end

local function fill(x, y, width, color)
    if width <= 0 then
        return
    end

    width = math.min(width, W - x + 1)

    monitor.setCursorPos(x, y)
    monitor.setBackgroundColor(color)
    monitor.write(string.rep(" ", width))
    monitor.setBackgroundColor(colors.black)
end

local function clear()
    monitor.setBackgroundColor(colors.black)
    monitor.clear()
end

local function centered(y, text, fg, bg)
    local x =
        math.floor((W - #text) / 2) + 1

    writeAt(x, y, text, fg, bg)
end

--------------------------------------------------
-- BUTTONS
--------------------------------------------------

local buttons = {}

local function addButton(name, x1, y1, x2, y2, text, color)
    buttons[name] = {
        x1 = x1,
        y1 = y1,
        x2 = x2,
        y2 = y2,
        text = text,
        color = color
    }
end

local function drawButton(button)
    for y = button.y1, button.y2 do
        fill(
            button.x1,
            y,
            button.x2 - button.x1 + 1,
            button.color
        )
    end

    local centerX =
        math.floor(
            (button.x1 + button.x2 - #button.text + 1)
            / 2
        )

    local centerY =
        math.floor(
            (button.y1 + button.y2)
            / 2
        )

    writeAt(
        centerX,
        centerY,
        button.text,
        colors.white,
        button.color
    )
end

local function inside(button, x, y)
    return
        x >= button.x1
        and x <= button.x2
        and y >= button.y1
        and y <= button.y2
end

--------------------------------------------------
-- CONTROL LAYOUT
--------------------------------------------------

local controlY = H - 4
local centerX = math.floor(W / 2)

addButton(
    "left",
    centerX - 15,
    controlY,
    centerX - 7,
    controlY + 2,
    "<",
    colors.blue
)

addButton(
    "down",
    centerX - 4,
    controlY,
    centerX + 4,
    controlY + 2,
    "v",
    colors.blue
)

addButton(
    "right",
    centerX + 7,
    controlY,
    centerX + 15,
    controlY + 2,
    ">",
    colors.blue
)

addButton(
    "up",
    centerX - 4,
    controlY - 3,
    centerX + 4,
    controlY - 1,
    "^",
    colors.blue
)

--------------------------------------------------
-- BORDER
--------------------------------------------------

local function drawBorder()
    for x = 1, W do
        writeAt(
            x,
            3,
            " ",
            colors.white,
            colors.gray
        )

        writeAt(
            x,
            MAX_Y + 1,
            " ",
            colors.white,
            colors.gray
        )
    end

    for y = 3, MAX_Y + 1 do
        writeAt(
            1,
            y,
            " ",
            colors.white,
            colors.gray
        )

        writeAt(
            W,
            y,
            " ",
            colors.white,
            colors.gray
        )
    end
end

--------------------------------------------------
-- HEADER
--------------------------------------------------

local function drawHeader()
    writeAt(
        2,
        1,
        "COOK'S SNAKE",
        colors.lime
    )

    local scoreText =
        "SCORE " .. score

    local highText =
        "BEST " .. highScore

    writeAt(
        math.floor(W / 2)
            - math.floor(#scoreText / 2),
        1,
        scoreText,
        colors.white
    )

    writeAt(
        W - #highText - 1,
        1,
        highText,
        colors.yellow
    )
end

--------------------------------------------------
-- SNAKE
--------------------------------------------------

local function snakeContains(x, y)
    for _, part in ipairs(snake) do
        if part.x == x
            and part.y == y
        then
            return true
        end
    end

    return false
end

local function drawSnake()
    for i, part in ipairs(snake) do
        local color

        if i == 1 then
            color = colors.lime
        else
            color = colors.green
        end

        writeAt(
            part.x,
            part.y,
            " ",
            colors.white,
            color
        )
    end
end

--------------------------------------------------
-- FOOD
--------------------------------------------------

local function spawnFood()
    repeat
        food = {
            x = math.random(MIN_X, MAX_X),
            y = math.random(MIN_Y, MAX_Y)
        }
    until not snakeContains(food.x, food.y)
end

local function drawFood()
    writeAt(
        food.x,
        food.y,
        " ",
        colors.white,
        colors.red
    )
end

--------------------------------------------------
-- CONTROLS
--------------------------------------------------

local function drawControls()
    drawButton(buttons.up)
    drawButton(buttons.left)
    drawButton(buttons.down)
    drawButton(buttons.right)

    centered(
        H,
        "TOUCH TO MOVE",
        colors.gray
    )
end

--------------------------------------------------
-- GAME SCREEN
--------------------------------------------------

local function drawGame()
    clear()

    drawHeader()
    drawBorder()
    drawFood()
    drawSnake()
    drawControls()
end

--------------------------------------------------
-- START SCREEN
--------------------------------------------------

local function drawStartScreen()
    clear()

    centered(
        math.floor(H / 2) - 4,
        "COOK'S SNAKE",
        colors.lime
    )

    centered(
        math.floor(H / 2) - 2,
        "TOUCH THE SCREEN TO PLAY",
        colors.white
    )

    centered(
        math.floor(H / 2),
        "EAT RED BLOCKS",
        colors.red
    )

    centered(
        math.floor(H / 2) + 1,
        "DON'T HIT THE WALLS",
        colors.gray
    )

    centered(
        math.floor(H / 2) + 2,
        "DON'T HIT YOURSELF",
        colors.gray
    )

    local buttonWidth = 20
    local bx1 =
        math.floor(W / 2)
        - math.floor(buttonWidth / 2)

    local bx2 =
        bx1 + buttonWidth

    local by =
        math.floor(H / 2) + 5

    addButton(
        "start",
        bx1,
        by,
        bx2,
        by + 2,
        "PLAY",
        colors.green
    )

    drawButton(buttons.start)
end

--------------------------------------------------
-- GAME OVER
--------------------------------------------------

local function drawGameOver()
    drawGame()

    local boxWidth = 30
    local boxHeight = 9

    local x1 =
        math.floor(W / 2)
        - math.floor(boxWidth / 2)

    local y1 =
        math.floor(MAX_Y / 2)
        - 4

    for y = y1, y1 + boxHeight do
        fill(
            x1,
            y,
            boxWidth,
            colors.black
        )
    end

    centered(
        y1 + 1,
        "GAME OVER",
        colors.red
    )

    centered(
        y1 + 3,
        "SCORE: " .. score,
        colors.white
    )

    centered(
        y1 + 4,
        "BEST: " .. highScore,
        colors.yellow
    )

    addButton(
        "restart",
        x1 + 5,
        y1 + 6,
        x1 + boxWidth - 6,
        y1 + 8,
        "PLAY AGAIN",
        colors.green
    )

    drawButton(buttons.restart)
end

--------------------------------------------------
-- RESET
--------------------------------------------------

local function resetGame()
    local centerX =
        math.floor(
            (MIN_X + MAX_X) / 2
        )

    local centerY =
        math.floor(
            (MIN_Y + MAX_Y) / 2
        )

    snake = {
        {
            x = centerX,
            y = centerY
        },

        {
            x = centerX - 1,
            y = centerY
        },

        {
            x = centerX - 2,
            y = centerY
        }
    }

    direction = {
        x = 1,
        y = 0
    }

    nextDirection = {
        x = 1,
        y = 0
    }

    score = 0
    speed = START_SPEED

    gameOver = false
    started = true

    spawnFood()
    drawGame()
end

--------------------------------------------------
-- MOVE
--------------------------------------------------

local function moveSnake()
    direction = nextDirection

    local head = snake[1]

    local newHead = {
        x = head.x + direction.x,
        y = head.y + direction.y
    }

    --------------------------------------------------
    -- WALL
    --------------------------------------------------

    if newHead.x < MIN_X
        or newHead.x > MAX_X
        or newHead.y < MIN_Y
        or newHead.y > MAX_Y
    then
        gameOver = true
        return
    end

    --------------------------------------------------
    -- SELF
    --------------------------------------------------

    if snakeContains(
        newHead.x,
        newHead.y
    )
    then
        gameOver = true
        return
    end

    table.insert(
        snake,
        1,
        newHead
    )

    --------------------------------------------------
    -- FOOD
    --------------------------------------------------

    if newHead.x == food.x
        and newHead.y == food.y
    then
        score = score + 1

        if score > highScore then
            highScore = score
        end

        speed =
            math.max(
                MIN_SPEED,
                START_SPEED
                - score * 0.006
            )

        spawnFood()
    else
        table.remove(snake)
    end
end

--------------------------------------------------
-- TOUCH HANDLER
--------------------------------------------------

local function handleTouch(x, y)
    --------------------------------------------------
    -- START
    --------------------------------------------------

    if not started then
        if buttons.start
            and inside(
                buttons.start,
                x,
                y
            )
        then
            resetGame()
        end

        return
    end

    --------------------------------------------------
    -- GAME OVER
    --------------------------------------------------

    if gameOver then
        if buttons.restart
            and inside(
                buttons.restart,
                x,
                y
            )
        then
            resetGame()
        end

        return
    end

    --------------------------------------------------
    -- UP
    --------------------------------------------------

    if inside(buttons.up, x, y) then
        if direction.y ~= 1 then
            nextDirection = {
                x = 0,
                y = -1
            }
        end

    --------------------------------------------------
    -- DOWN
    --------------------------------------------------

    elseif inside(buttons.down, x, y) then
        if direction.y ~= -1 then
            nextDirection = {
                x = 0,
                y = 1
            }
        end

    --------------------------------------------------
    -- LEFT
    --------------------------------------------------

    elseif inside(buttons.left, x, y) then
        if direction.x ~= 1 then
            nextDirection = {
                x = -1,
                y = 0
            }
        end

    --------------------------------------------------
    -- RIGHT
    --------------------------------------------------

    elseif inside(buttons.right, x, y) then
        if direction.x ~= -1 then
            nextDirection = {
                x = 1,
                y = 0
            }
        end
    end
end

--------------------------------------------------
-- GAME LOOP
--------------------------------------------------

local function gameLoop()
    while running do
        if started and not gameOver then
            sleep(speed)

            moveSnake()

            if gameOver then
                drawGameOver()
            else
                drawGame()
            end
        else
            sleep(0.05)
        end
    end
end

--------------------------------------------------
-- TOUCH LOOP
--------------------------------------------------

local function touchLoop()
    while running do
        local event, side, x, y =
            os.pullEvent("monitor_touch")

        handleTouch(x, y)
    end
end

