--------------------------------------------------
-- GAME OVER SCREEN
--------------------------------------------------

local function drawGameOver()
    drawGame()

    local boxWidth = 32
    local x1 =
        centerX - math.floor(boxWidth / 2)

    local x2 =
        x1 + boxWidth

    local y1 = 10
    local y2 = 22

    for y = y1, y2 do
        fill(
            x1,
            y,
            boxWidth,
            colors.black
        )
    end

    centered(
        12,
        "GAME OVER",
        colors.red
    )

    centered(
        15,
        "SCORE: " .. score,
        colors.white
    )

    centered(
        17,
        "BEST: " .. highScore,
        colors.yellow
    )

    addButton(
        "restart",
        centerX - 9,
        19,
        centerX + 9,
        21,
        "PLAY AGAIN",
        colors.green
    )

    drawButton(buttons.restart)
end

--------------------------------------------------
-- RESET
--------------------------------------------------

local function resetGame()
    local centerGameX =
        math.floor((MIN_X + MAX_X) / 2)

    local centerGameY =
        math.floor((MIN_Y + MAX_Y) / 2)

    snake = {
        {
            x = centerGameX,
            y = centerGameY
        },
        {
            x = centerGameX - 1,
            y = centerGameY
        },
        {
            x = centerGameX - 2,
            y = centerGameY
        }
    }

    direction = {x = 1, y = 0}
    nextDirection = {x = 1, y = 0}

    score = 0
    speed = START_SPEED

    started = true
    gameOver = false

    spawnFood()
    drawGame()
end

--------------------------------------------------
-- MOVE
--------------------------------------------------

local function moveSnake()
    direction = nextDirection

    local head = snake[1]

    local newHead = {
        x = head.x + direction.x,
        y = head.y + direction.y
    }

    if newHead.x < MIN_X
        or newHead.x > MAX_X
        or newHead.y < MIN_Y
        or newHead.y > MAX_Y
    then
        gameOver = true
        return
    end

    if snakeContains(newHead.x, newHead.y) then
        gameOver = true
        return
    end

    table.insert(
        snake,
        1,
        newHead
    )

    if newHead.x == food.x
        and newHead.y == food.y
    then
        score = score + 1

        if score > highScore then
            highScore = score
        end

        speed =
            math.max(
                MIN_SPEED,
                START_SPEED - score * 0.006
            )

        spawnFood()
    else
        table.remove(snake)
    end
end

--------------------------------------------------
-- TOUCH INPUT
--------------------------------------------------

local function handleTouch(x, y)
    if not started then
        if buttons.start
            and inside(buttons.start, x, y)
        then
            resetGame()
        end

        return
    end

    if gameOver then
        if buttons.restart
            and inside(buttons.restart, x, y)
        then
            resetGame()
        end

        return
    end

    if inside(buttons.up, x, y) then
        if direction.y ~= 1 then
            nextDirection = {
                x = 0,
                y = -1
            }
        end

    elseif inside(buttons.down, x, y) then
        if direction.y ~= -1 then
            nextDirection = {
                x = 0,
                y = 1
            }
        end

    elseif inside(buttons.left, x, y) then
        if direction.x ~= 1 then
            nextDirection = {
                x = -1,
                y = 0
            }
        end

    elseif inside(buttons.right, x, y) then
        if direction.x ~= -1 then
            nextDirection = {
                x = 1,
                y = 0
            }
        end
    end
end

--------------------------------------------------
-- GAME LOOP
--------------------------------------------------

local function gameLoop()
    while running do
        if started and not gameOver then
            sleep(speed)

            moveSnake()

            if gameOver then
                drawGameOver()
            else
                drawGame()
            end
        else
            sleep(0.05)
        end
    end
end

--------------------------------------------------
-- TOUCH LOOP
--------------------------------------------------

local function touchLoop()
    while running do
        local _, side, x, y =
            os.pullEvent("monitor_touch")

        handleTouch(x, y)
    end
end

